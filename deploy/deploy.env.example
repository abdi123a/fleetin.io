# Copy to deploy/deploy.env (gitignored) and fill in.
#
# This file is `source`d by bash, so EVERY VALUE MUST BE QUOTED.

SSH_HOST="srv1141721.hstgr.cloud"
SSH_USER=""                   # CloudPanel site user, NOT root
SSH_PORT="22"

# Web root the domain serves from — under CloudPanel usually
# /home/<site-user>/htdocs/<domain>
REMOTE_DIR=""

# Which backend the built bundle talks to. VITE_API_BASE_URL is inlined at
# BUILD time, so this decides it permanently for the uploaded files.
BUILD_MODE="cloud"

# Checked after upload; a non-2xx fails the deploy.
HEALTH_URL="https://app.fleetin.hammi.cloud/"
