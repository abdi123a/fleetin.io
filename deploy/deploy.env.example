# Copy to deploy/deploy.env (gitignored) and fill in.
#
# This file is `source`d by bash, so EVERY VALUE MUST BE QUOTED — an unquoted
# `RESTART_CMD=pm2 restart fleetin-api` makes bash try to run `restart`.

# --- Where the app runs -----------------------------------------------------
SSH_HOST="srv1141721.hstgr.cloud"     # or "72.61.192.11"
SSH_USER=""                            # the CloudPanel site user, NOT root
SSH_PORT="22"

# Absolute path to the release directory on the server. Under CloudPanel this
# is usually /home/<site-user>/htdocs/<domain>.
REMOTE_DIR=""

# --- How the process is restarted -------------------------------------------
# Whatever brings the API back up, e.g.
#   RESTART_CMD="pm2 restart fleetin-api"
#   RESTART_CMD="sudo systemctl restart fleetin-api"
RESTART_CMD=""

# --- Verification -----------------------------------------------------------
# Hit after restart; anything other than 200/204/401 fails the deploy.
HEALTH_URL="https://api.fleetin.hammi.cloud/api/v1/health"

# --- Backups ----------------------------------------------------------------
# Where dumps are written on the server before migrations run.
REMOTE_BACKUP_DIR="~/fleetin-backups"
KEEP_BACKUPS="10"
