# ---------------------------------------------------------------------------
# FLEETIN Backend — environment template.
#
# Copy to .env and fill in. Every variable without a default is REQUIRED:
# the app validates this file at boot (src/config/env.config.ts) and refuses
# to start if anything is missing or malformed. There are no fallback secrets
# in source code — a missing JWT secret is a crash, not a silent default.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# --- Database (MySQL) ------------------------------------------------------
# Local Homebrew MySQL usually has user 'root' with no password:
#   mysql://root@localhost:3306/fleetin_db
# With a password:
#   mysql://root:yourpassword@localhost:3306/fleetin_db
DATABASE_URL="mysql://root@localhost:3306/fleetin_db"

# --- JWT -------------------------------------------------------------------
# REQUIRED. Minimum 32 characters each, and they must differ from each other.
# Generate with:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN="7d"

# --- Redis (cache + BullMQ queues) -----------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Storage ---------------------------------------------------------------
# 'local' writes to STORAGE_LOCAL_PATH (development).
# 's3' requires S3_REGION, S3_BUCKET, S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY;
# the app validates that block at boot when the driver is 's3'.
# S3_ENDPOINT is optional — set it for S3-compatible hosts (R2, MinIO, Spaces).
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- Mail ------------------------------------------------------------------
# Optional in development: with no API key MailService logs instead of sending.
RESEND_API_KEY=
EMAIL_FROM="FLEETIN System <noreply@fleetin.com>"

# --- Google Maps Platform --------------------------------------------------
# Powers the location search (Places API, New) and real road distance between
# two locations (Routes API). Enable BOTH of those APIs on the project and
# leave billing on — a key with only one enabled fails half the feature.
#
# Server-side only. This key never reaches the browser: the frontend calls
# /locations/search and /locations/distance, and the backend calls Google. So
# restrict it by SERVER IP, not by HTTP referrer, and restrict it to those two
# APIs and nothing else.
#
# Optional. Without it the Locations module still works — a place can be added
# by hand with its own coordinates, and distance falls back to the straight-line
# estimate — and the Google-backed endpoints answer "not configured" instead of
# failing.
GOOGLE_MAPS_API_KEY=

# Where place search is biased toward, so "doraleh" offers the terminal rather
# than a street on another continent. Defaults cover the Djibouti corridor.
GOOGLE_MAPS_BIAS_LAT=11.5721
GOOGLE_MAPS_BIAS_LNG=43.1456
GOOGLE_MAPS_BIAS_RADIUS_M=300000
