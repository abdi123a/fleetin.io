{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web \u2192 local API (:3000)",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:local"
      ],
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "fleetin-dev-local-api",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "VITE_API_BASE_URL=http://localhost:3000/api/v1 npx vite --port 5199"
      ],
      "port": 5199,
      "autoPort": true
    },
    {
      "name": "fleetin-dev-local-api-verify",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "VITE_API_BASE_URL=http://localhost:3000/api/v1 npx vite --port 5299 --strictPort"
      ],
      "port": 5299,
      "autoPort": false
    },
    {
      "name": "fleetin-backend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "/Users/abdihakim/Documents/Fleetin Internal Managemnt system/fleetin-backend",
        "run",
        "start:dev"
      ],
      "port": 3000,
      "url": "http://localhost:3000/",
      "autoPort": false
    },
    {
      "name": "fleetin-dev-cloud-verify",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npx vite --port 5399 --strictPort"
      ],
      "port": 5399,
      "autoPort": false
    },
    {
      "name": "fleetin-dev-co2-verify",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "VITE_API_BASE_URL=http://localhost:3000/api/v1 npx vite --port 5399 --strictPort"
      ],
      "port": 5399,
      "autoPort": true
    }
  ]
}