# Mode: `vite --mode localapi` (npm run dev:local)
#
# Points the app at the NestJS backend running on this machine
# (../fleetin-backend, `npm run dev:backend`). Vite loads `.env` first and then
# this file, so the value here wins over whatever `.env` holds.
#
# Committed on purpose: it contains no secret, and the whole point is that
# "which backend am I on" is answerable by reading the repo rather than by
# remembering which terminal you started.
VITE_API_BASE_URL=http://localhost:3000/api/v1
