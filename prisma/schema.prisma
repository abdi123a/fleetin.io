generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?  @db.Text
  permissions Json // Granular permissions e.g. ["users:read", "shipments:create"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@map("roles")
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  passwordHash      String
  firstName         String
  lastName          String
  phoneNumber       String?
  avatarUrl         String?
  status            UserStatus         @default(ACTIVE)
  roleId            String
  role              Role               @relation(fields: [roleId], references: [id])
  refreshTokens     RefreshToken[]
  /// Portal scoping (BR-10.5) — set only for SHIPPER-role accounts, whose
  /// queries are row-filtered to this company's own data.
  shipperId         String?
  shipper           Shipper?           @relation(fields: [shipperId], references: [id])
  /// Portal scoping (BR-10.5) — set only for TRANSPORTER-role accounts.
  partnerId         String?
  partner           Partner?           @relation(fields: [partnerId], references: [id])
  /// Shipments this account is on the crew of, and shipments where it put
  /// somebody else on the crew.
  shipmentCrew      ShipmentAssignee[] @relation("ShipmentCrew")
  shipmentCrewAdded ShipmentAssignee[] @relation("ShipmentCrewAssigner")
  /// Everything this account has said on a shipment or one of its bookings.
  comments          Comment[]

  /// Workspace. Named relations throughout: User reaches WorkspaceMessage five
  /// different ways, and Prisma cannot disambiguate them positionally.
  workspaceTasksAssigned       WorkspaceTask[]              @relation("WorkspaceTaskAssignee")
  workspaceTasksCreated        WorkspaceTask[]              @relation("WorkspaceTaskCreator")
  workspaceTicketsOpened       WorkspaceTicket[]            @relation("WorkspaceTicketOpener")
  workspaceMessages            WorkspaceMessage[]           @relation("WorkspaceMessageAuthor")
  workspaceMessagesAssigned    WorkspaceMessage[]           @relation("WorkspaceMessageAssignee")
  workspaceMessagesAssignedBy  WorkspaceMessage[]           @relation("WorkspaceMessageAssigner")
  workspaceMessagesResolved    WorkspaceMessage[]           @relation("WorkspaceMessageResolver")
  workspaceMentions            WorkspaceMention[]
  workspaceTaskEvents          WorkspaceTaskEvent[]
  workspaceNotifications       WorkspaceNotification[]      @relation("WorkspaceNotificationRecipient")
  workspaceNotificationsActed  WorkspaceNotification[]      @relation("WorkspaceNotificationActor")
  workspaceChannelsCreated     WorkspaceChannel[]           @relation("WorkspaceChannelCreator")
  workspaceChannelMemberships  WorkspaceChannelMember[]
  workspaceChecklistCompleted  WorkspaceTaskChecklistItem[] @relation("WorkspaceChecklistCompleter")
  workspaceTasksFollowed       WorkspaceTaskFollower[]      @relation("WorkspaceTaskFollower")
  workspaceTemplatesCreated    WorkspaceTaskTemplate[]      @relation("WorkspaceTemplateCreator")
  workspaceRecurrencesAssigned WorkspaceTaskRecurrence[]    @relation("WorkspaceRecurrenceAssignee")
  workspaceRecurrencesCreated  WorkspaceTaskRecurrence[]    @relation("WorkspaceRecurrenceCreator")
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt

  @@index([roleId])
  @@index([shipperId])
  @@index([partnerId])
  @@map("users")
}

/// One issued refresh token.
///
/// The raw token is never stored — only `tokenHash`, so a database leak does
/// not hand over live sessions. `familyId` groups every token rotated from a
/// single login, which is what makes reuse detection possible: replaying an
/// already-rotated token revokes the whole family rather than just that row.
model RefreshToken {
  id           String    @id @default(uuid())
  /// SHA-256 hex digest of the issued token (64 chars).
  tokenHash    String    @unique @db.VarChar(64)
  /// Session family id — shared by every token descended from one login.
  familyId     String    @db.VarChar(36)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  isRevoked    Boolean   @default(false)
  revokedAt    DateTime?
  /// Id of the token that superseded this one during rotation. Present on a
  /// normally-rotated token; null on the newest token in a family.
  replacedById String?   @db.VarChar(36)
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ─── 0. Platform settings ────────────────────────────────────────────────────

/// One row, ever. `id` is pinned to `SINGLETON` so there is no way to end up
/// with two competing configurations — every reader upserts and reads that
/// one key.
model AppSettings {
  id String @id @default("SINGLETON") @db.VarChar(16)

  /// Fleetin's cut, as a percentage of the shipment total, applied
  /// identically to every transporter — one house rate, not a per-partner
  /// negotiation.
  ///
  /// The direction matters and is easy to get backwards: a partner's
  /// The shipment's entered price is what the SHIPPER pays, already inclusive of this
  /// percentage. The transporter is paid that total MINUS this percentage.
  /// So the shipper sees one number, and Fleetin's margin is that number
  /// times this rate. Stored as a percentage (7.5 means 7.5%), not a
  /// fraction.
  fleetinCommissionPct Float @default(0)

  updatedAt     DateTime @updatedAt
  updatedById   String?
  updatedByName String?  @db.VarChar(255)

  @@map("app_settings")
}

// ─── 1. Append-Only Ledger (Single Source of Truth) ──────────────────────────

model LedgerEntry {
  id                   String   @id @default(uuid())
  entryDate            DateTime
  postedAt             DateTime @default(now())
  type                 String   @db.VarChar(32)
  direction            String   @db.VarChar(4) // 'IN' | 'OUT'
  amountMinorUnits     BigInt
  scale                Int      @default(0)
  currency             String   @db.VarChar(8)
  fxRate               Float    @default(1.0)
  baseAmountMinorUnits BigInt
  counterpartyType     String   @db.VarChar(16) // SHIPPER | TRANSPORTER | BANK | EMPLOYEE | VENDOR
  counterpartyId       String
  counterpartyName     String   @db.VarChar(255)
  bankAccountId        String?
  sourceType           String   @db.VarChar(32) // invoice | payment | drawdown | payment_order | expense | credit_note
  sourceId             String
  missionId            String?
  description          String   @db.Text
  createdById          String
  createdByName        String   @db.VarChar(255)
  reversedByEntryId    String?

  @@index([missionId])
  @@index([counterpartyId, counterpartyType])
  @@index([entryDate])
  @@map("ledger_entries")
}

// ─── 2. Bank Accounts ────────────────────────────────────────────────────────

model BankAccount {
  id             String   @id @default(uuid())
  bankName       String   @db.VarChar(255)
  accountHolder  String   @db.VarChar(255)
  accountNumber  String   @db.VarChar(64)
  iban           String?  @db.VarChar(64)
  swiftCode      String?  @db.VarChar(32)
  currency       String   @db.VarChar(8)
  openingBalance BigInt   @default(0)
  currentBalance BigInt   @default(0)
  isActive       Boolean  @default(true)
  isPrimary      Boolean  @default(false)
  /// StorageService key for the bank's logo, not a URL — the URL is derived per request.
  logoKey        String?  @db.VarChar(512)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  payments       Payment[]
  drawdowns      Drawdown[]
  statementLines BankStatementLine[]
  facilities     CreditFacility[]
  movements      BankMovement[]

  @@map("bank_accounts")
}

/**
 * A hand-entered cash movement on an account Fleetin owns: a deposit, a
 * withdrawal, or one leg of a transfer between two of its own accounts.
 * Distinct from `BankStatementLine`, which is an IMPORTED line off the bank's
 * own statement waiting to be matched. This table is the opposite direction —
 * the finance desk stating what it did, which then moves `currentBalance`.
 * A transfer writes exactly two rows sharing one `groupId`: TRANSFER_OUT on
 * the source and TRANSFER_IN on the destination.
 */
model BankMovement {
  id                     String      @id @default(uuid())
  /// e.g. "BMV-00042".
  reference              String      @unique @db.VarChar(32)
  bankAccountId          String
  bankAccount            BankAccount @relation(fields: [bankAccountId], references: [id])
  type                   String      @db.VarChar(16) // DEPOSIT | WITHDRAWAL | TRANSFER_IN | TRANSFER_OUT
  direction              String      @db.VarChar(4) // IN | OUT
  amountMinorUnits       BigInt
  currency               String      @db.VarChar(8)
  /// Balance of `bankAccountId` immediately after this movement was applied.
  balanceAfterMinorUnits BigInt
  /// The other account, for transfer legs only.
  counterpartyAccountId  String?
  /// Shared by the two legs of one transfer; null on deposits and withdrawals.
  groupId                String?
  method                 String?     @db.VarChar(24) // CASH | BANK_TRANSFER | CHEQUE | MOBILE_MONEY
  externalReference      String?     @db.VarChar(128)
  description            String?     @db.Text
  occurredAt             DateTime
  createdById            String
  createdByName          String      @db.VarChar(255)
  createdAt              DateTime    @default(now())

  @@index([bankAccountId])
  @@index([groupId])
  @@index([occurredAt])
  @@map("bank_movements")
}

model BankStatementLine {
  id               String      @id @default(uuid())
  bankAccountId    String
  bankAccount      BankAccount @relation(fields: [bankAccountId], references: [id])
  statementDate    DateTime
  description      String      @db.Text
  amountMinorUnits BigInt
  direction        String      @db.VarChar(4)
  reference        String?     @db.VarChar(128)
  matchedPaymentId String?
  matchStatus      String      @default("UNMATCHED") @db.VarChar(16)
  importedAt       DateTime    @default(now())

  @@index([bankAccountId])
  @@index([reference])
  @@map("bank_statement_lines")
}

// ─── 3. Invoices (Accounts Receivable) ───────────────────────────────────────

model InvoiceCounter {
  series String @db.VarChar(8)
  year   Int
  last   Int    @default(0)

  @@id([series, year])
  @@map("invoice_counters")
}

/// A bill, or the quote that precedes it — one document type, two faces.
///
/// Both are built from exactly one shipment and its bookings, and that is the
/// whole billing model: no monthly statement, no multi-shipment roll-up. A
/// proforma tells the client what the job will be and what it will cost
/// before it runs; the invoice is the same paper once the work is real. The
/// proforma is issued first, the invoice is raised from the same shipment
/// after, and `proformaId` links the two so the client can see they match.
model Invoice {
  id     String @id @default(uuid())
  number String @unique @db.VarChar(32)

  /// `proforma` (a quote — nothing is owed) or `invoice` (a bill). The two
  /// print on the same paper with a different title and a different closing
  /// line, and only an `invoice` can be marked paid.
  kind String @default("invoice") @db.VarChar(16)

  /// The one shipment this document bills. The old `missionIds` array is kept
  /// below for the historical rows written when a document could cover a
  /// whole month; nothing writes more than one id into it any more.
  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id])

  /// The document's own line items, snapshotted from the shipment's bookings
  /// at issue time: `[{ reference, containerNo, description, qty,
  /// unitMinorUnits, totalMinorUnits }]`.
  ///
  /// A snapshot rather than a live join on purpose — a container added to the
  /// shipment next week must not silently rewrite a document the client has
  /// already been sent and may have already paid.
  lines Json?

  /// How Fleetin's cut was worked out on THIS document, and what it came to.
  ///
  /// `commissionMode` is `percent` or `fixed`; `commissionPct` carries the
  /// percentage and `commissionFixedMinorUnits` the per-container fee, with
  /// only the relevant one meaningful. `commissionSource` records which deal
  /// won — `shipper`, `transporter` or `house` — so an operator reading the
  /// document can see why the rate is what it is.
  ///
  /// All four are SNAPSHOTS, for the same reason as `lines`: renegotiating a
  /// rate must never restate what Fleetin earned on work already billed.
  commissionMode            String @default("percent") @db.VarChar(8)
  commissionSource          String @default("house") @db.VarChar(12)
  commissionPct             Float  @default(0)
  commissionFixedMinorUnits BigInt @default(0)
  commissionMinorUnits      BigInt @default(0)

  /// Set when the shipper's money actually arrived.
  paidAt DateTime?

  /// The quote this bill was raised from, when there was one.
  proformaId String?

  shipperId            String
  shipperName          String    @db.VarChar(255)
  shipperCompany       String    @db.VarChar(255)
  missionIds           Json
  description          String    @db.Text
  subtotalMinorUnits   BigInt
  taxMinorUnits        BigInt    @default(0)
  totalMinorUnits      BigInt
  currency             String    @db.VarChar(8)
  fxRate               Float     @default(1.0)
  baseAmountMinorUnits BigInt
  contractDeadline     DateTime
  issueDate            DateTime
  sentAt               DateTime?
  status               String    @default("Draft") @db.VarChar(16)
  allocatedMinorUnits  BigInt    @default(0)
  remainingMinorUnits  BigInt
  notes                String?   @db.Text
  disputeReason        String?   @db.Text
  writeOffReason       String?   @db.Text
  writtenOffAt         DateTime?
  writtenOffById       String?
  issuedById           String
  issuedByName         String    @db.VarChar(255)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  /// The calendar month this invoice bills. Set on a monthly statement — the
  /// shipper's single end-of-month bill covering every shipment that ran in
  /// the window — and null on a one-off single-shipment invoice. Together
  /// with `shipperId` these make a statement idempotent: one statement per
  /// shipper per month, re-runnable without double-billing.
  periodStart DateTime?
  periodEnd   DateTime?

  /// Set when the statement was scoped to one project rather than to
  /// everything the shipper ran that month. Null on a shipper-wide statement.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  creditNotes CreditNote[]
  allocations PaymentAllocation[]

  @@index([shipperId])
  @@index([status])
  @@index([contractDeadline])
  @@index([shipperId, periodStart])
  @@index([projectId])
  @@index([shipmentId])
  @@index([kind])
  @@map("invoices")
}

model CreditNote {
  id                String    @id @default(uuid())
  number            String    @unique @db.VarChar(32)
  originalInvoiceId String
  originalInvoice   Invoice   @relation(fields: [originalInvoiceId], references: [id])
  reason            String    @db.Text
  amountMinorUnits  BigInt
  currency          String    @db.VarChar(8)
  issueDate         DateTime
  issuedById        String
  issuedByName      String    @db.VarChar(255)
  approvedById      String?
  approvedByName    String?   @db.VarChar(255)
  approvedAt        DateTime?

  @@index([originalInvoiceId])
  @@map("credit_notes")
}

// ─── 4. Transporter Payment Orders (Accounts Payable) ────────────────────────

model PaymentOrder {
  id                   String    @id @default(uuid())
  number               String    @unique @db.VarChar(32)
  transporterId        String
  transporterName      String    @db.VarChar(255)
  transporterCompany   String    @db.VarChar(255)
  missionId            String
  driverName           String?   @db.VarChar(255)
  assignedTruckPlate   String?   @db.VarChar(64)
  route                String    @db.VarChar(255)
  amountMinorUnits     BigInt
  currency             String    @db.VarChar(8)
  fxRate               Float     @default(1.0)
  baseAmountMinorUnits BigInt
  status               String    @default("Pending") @db.VarChar(16)
  createdById          String
  createdByName        String    @db.VarChar(255)
  approvedById         String?
  approvedByName       String?   @db.VarChar(255)
  approvedAt           DateTime?
  paidAt               DateTime?
  drawdownId           String?
  drawdown             Drawdown? @relation(fields: [drawdownId], references: [id])
  paymentMethod        String?   @db.VarChar(32)
  notes                String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  allocations PaymentAllocation[]

  @@index([transporterId])
  @@index([missionId])
  @@index([status])
  @@map("payment_orders")
}

// ─── 5. Payments & Allocations ───────────────────────────────────────────────

model Payment {
  id                    String       @id @default(uuid())
  number                String       @unique @db.VarChar(32)
  direction             String       @db.VarChar(4) // 'IN' | 'OUT'
  counterpartyType      String       @db.VarChar(16)
  counterpartyId        String
  counterpartyName      String       @db.VarChar(255)
  amountMinorUnits      BigInt
  currency              String       @db.VarChar(8)
  fxRate                Float        @default(1.0)
  baseAmountMinorUnits  BigInt
  unallocatedMinorUnits BigInt       @default(0)
  paidAt                DateTime
  method                String       @db.VarChar(32)
  bankAccountId         String?
  bankAccount           BankAccount? @relation(fields: [bankAccountId], references: [id])
  reference             String?      @db.VarChar(128)
  createdById           String
  createdByName         String       @db.VarChar(255)
  approvedById          String?
  approvedByName        String?      @db.VarChar(255)
  approvedAt            DateTime?
  createdAt             DateTime     @default(now())

  allocations PaymentAllocation[]

  @@index([bankAccountId])
  @@index([counterpartyId])
  @@map("payments")
}

model PaymentAllocation {
  id               String   @id @default(uuid())
  paymentId        String
  payment          Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  targetType       String   @db.VarChar(16) // INVOICE | PAYMENT_ORDER | DRAWDOWN
  targetId         String
  amountMinorUnits BigInt
  allocatedAt      DateTime @default(now())

  invoiceId      String?
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id])
  paymentOrderId String?
  paymentOrder   PaymentOrder? @relation(fields: [paymentOrderId], references: [id])
  drawdownId     String?
  drawdown       Drawdown?     @relation(fields: [drawdownId], references: [id])

  @@index([paymentId])
  @@index([invoiceId])
  @@index([paymentOrderId])
  @@index([drawdownId])
  @@map("payment_allocations")
}

// ─── 6. Can International Bank Facility & Drawdowns ──────────────────────────

model CreditFacility {
  id              String      @id @default(uuid())
  bankName        String      @db.VarChar(255)
  facilityNumber  String      @unique @db.VarChar(64)
  limitMinorUnits BigInt
  currency        String      @db.VarChar(8)
  startDate       DateTime
  endDate         DateTime?
  isRevolving     Boolean     @default(true)
  feeDescription  String?     @db.Text
  status          String      @default("ACTIVE") @db.VarChar(16)
  bankAccountId   String
  bankAccount     BankAccount @relation(fields: [bankAccountId], references: [id])
  createdAt       DateTime    @default(now())

  drawdowns Drawdown[]

  @@map("credit_facilities")
}

model Drawdown {
  id               String         @id @default(uuid())
  number           String         @unique @db.VarChar(32)
  facilityId       String
  facility         CreditFacility @relation(fields: [facilityId], references: [id])
  amountMinorUnits BigInt
  currency         String         @db.VarChar(8)
  feesMinorUnits   BigInt         @default(0)
  disbursedAt      DateTime
  dueAt            DateTime
  status           String         @default("Active") @db.VarChar(16)
  exposureStatus   String         @default("COVERED") @db.VarChar(16)
  exposureReason   String?        @db.Text
  repaidMinorUnits BigInt         @default(0)
  bankAccountId    String?
  bankAccount      BankAccount?   @relation(fields: [bankAccountId], references: [id])
  createdById      String
  createdByName    String         @db.VarChar(255)
  approvedById     String?
  approvedByName   String?        @db.VarChar(255)
  approvedAt       DateTime?
  createdAt        DateTime       @default(now())

  fundedOrders PaymentOrder[]
  repayments   PaymentAllocation[]

  @@index([facilityId])
  @@index([status])
  @@index([exposureStatus])
  @@map("drawdowns")
}

// ─── 7. Internal Expenses & Recurring Templates ──────────────────────────────

model ExpenseEntry {
  id                   String                    @id @default(uuid())
  number               String                    @unique @db.VarChar(32)
  category             String                    @db.VarChar(32) // SALARY | RENT | UTILITIES | FUEL | TECHNOLOGY | ...
  description          String                    @db.Text
  amountMinorUnits     BigInt
  currency             String                    @db.VarChar(8)
  fxRate               Float                     @default(1.0)
  baseAmountMinorUnits BigInt
  incurredAt           DateTime
  paidById             String
  paidByName           String                    @db.VarChar(255)
  method               String                    @db.VarChar(32)
  receiptUrl           String?                   @db.Text
  status               String                    @default("Pending") @db.VarChar(16)
  isRecurring          Boolean                   @default(false)
  recurringTemplateId  String?
  template             RecurringExpenseTemplate? @relation(fields: [recurringTemplateId], references: [id])
  createdById          String
  createdByName        String                    @db.VarChar(255)
  approvedById         String?
  approvedByName       String?                   @db.VarChar(255)
  approvedAt           DateTime?
  paidAt               DateTime?
  notes                String?                   @db.Text
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([category])
  @@index([status])
  @@map("expense_entries")
}

model RecurringExpenseTemplate {
  id               String   @id @default(uuid())
  category         String   @db.VarChar(32)
  description      String   @db.Text
  amountMinorUnits BigInt
  currency         String   @db.VarChar(8)
  frequency        String   @db.VarChar(16) // MONTHLY | WEEKLY | QUARTERLY | ANNUAL
  nextDueAt        DateTime
  isActive         Boolean  @default(true)
  vendorOrPayee    String   @db.VarChar(255)
  createdAt        DateTime @default(now())

  entries ExpenseEntry[]

  @@map("recurring_expense_templates")
}

// ─── 8. Counterparties: Shippers & Partners ───────────────────────────────

model Shipper {
  id                 String @id @default(uuid())
  /// Preserves the frontend's display id, e.g. "SHP-101".
  reference          String @unique @db.VarChar(32)
  companyLegalName   String @db.VarChar(255)
  registrationNumber String @db.VarChar(64)
  industry           String @db.VarChar(120)
  companySize        String @db.VarChar(32) // Micro (1-10) | Small (11-50) | Medium (51-250) | Large (251-1000) | Enterprise (1000+)
  country            String @db.VarChar(120)
  address            String @db.Text
  projectsCount      Int    @default(0)
  approvalStatus     String @default("Pending") @db.VarChar(16) // Verified | Pending | Suspended | Canceled

  /// ── The deal struck with THIS client ──
  ///
  /// Fleetin's cut can be negotiated two ways, and both are in use:
  ///
  ///   - `percent` — a share of what the client is billed. `commissionPct`
  ///     carries it (7.5 means 7.5%).
  ///   - `fixed` — a flat fee PER BOOKING, i.e. per container.
  ///     `commissionFixedMinorUnits` carries it, and a document multiplies it
  ///     by the number of containers on the shipment.
  ///
  /// `commissionMode` NULL is the normal state and means "no special deal":
  /// the house rate under Settings applies. Nullable rather than defaulted,
  /// because a copied default would stop tracking the house rate the day
  /// somebody changed it. See `resolveCommission`.
  commissionMode            String?   @db.VarChar(8)
  commissionPct             Float?
  commissionFixedMinorUnits BigInt?
  registrationDate          DateTime
  /// StorageService key, not a URL — the URL is derived per request.
  logoKey                   String?   @db.VarChar(512)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  deletedAt                 DateTime?

  users     User[]
  shipments Shipment[]
  projects  Project[]

  @@index([approvalStatus])
  @@map("shippers")
}

model Partner {
  id                    String    @id @default(uuid())
  /// e.g. "PTR-001".
  reference             String    @unique @db.VarChar(32)
  companyLegalName      String    @db.VarChar(255)
  registrationNumber    String    @db.VarChar(64)
  businessLicenseNumber String?   @db.VarChar(64)
  operatingRegions      Json // string[]
  serviceCategories     Json // string[]
  /// Declared figure — deliberately NOT derived from vehicles.length.
  fleetSize             Int       @default(0)
  vehicleTypes          Json // string[]
  country               String    @db.VarChar(120)
  address               String    @db.Text
  insuranceProvider     String?   @db.VarChar(255)
  insurancePolicyNumber String?   @db.VarChar(120)
  insuranceExpiry       DateTime?
  partnerStatus         String    @default("Pending") @db.VarChar(16) // Active | Suspended | Pending | Inactive
  logoKey               String?   @db.VarChar(512)
  registrationDate      DateTime

  /// ── The deal struck with THIS haulier ──
  ///
  /// Same two modes and same nullable-means-house-rate contract as
  /// `Shipper.commissionMode` — a percentage of the job, or a flat fee per
  /// container. Lower priority than the client's deal: a rate agreed with the
  /// client wins, because the client's number is the one on the invoice.
  /// See `resolveCommission`.
  commissionMode            String? @db.VarChar(8)
  commissionPct             Float?
  commissionFixedMinorUnits BigInt?

  /// Where this transporter's trucks sleep.
  ///
  /// The one place the Fleetin Impact arithmetic needs that nothing else in
  /// the system recorded: the garage a truck goes back to between two jobs.
  /// Without a realized match the normal cycle is
  ///
  ///     Free Zone → Garage → Port
  ///
  /// and the two legs either side of the garage are what a continuation
  /// eliminates — so their length has to be measured from a real place, not a
  /// city name. A catalogue `Location` rather than a free-text address for the
  /// same reason a shipment's ends are: only a pin can be measured to.
  ///
  /// Nullable, and honestly so: a transporter with no garage recorded still
  /// has its continuations *recognised* (the match was realized), they are
  /// just not *measured* until somebody sets this. Never guessed from the
  /// address. See `EmptyReturnCycle.impactStatus`.
  garageLocationId String?
  garageLocation   Location? @relation("PartnerGarage", fields: [garageLocationId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users       User[]
  vehicles    Vehicle[]
  drivers     Driver[]
  bankAccount PartnerBankAccount?
  shipments   Shipment[]
  bookings    Booking[]

  @@index([partnerStatus])
  @@index([garageLocationId])
  @@map("partners")
}

/// Shared contact shape for Shipper primary/operational contacts and Partner
/// dispatchers — both entities carry an identical ContactPerson/
/// DispatcherContact shape today. Polymorphic on purpose, mirroring the
/// precedent LedgerEntry/Payment already set with counterpartyType/
/// counterpartyId (BR-1.4) — plain fields, no @relation, application code
/// does the join.
model Contact {
  id        String   @id @default(uuid())
  ownerType String   @db.VarChar(16) // SHIPPER | PARTNER
  ownerId   String
  name      String   @db.VarChar(255)
  title     String   @db.VarChar(120)
  email     String   @db.VarChar(255)
  phone     String   @db.VarChar(32)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ownerType, ownerId])
  @@map("contacts")
}

/// A partner's payout bank details — distinct from finance's own
/// BankAccount model, which represents FLEETIN's own accounts, not a
/// counterparty's.
model PartnerBankAccount {
  id            String   @id @default(uuid())
  partnerId     String   @unique
  partner       Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  bankName      String   @db.VarChar(255)
  accountHolder String   @db.VarChar(255)
  accountNumber String   @db.VarChar(64)
  iban          String?  @db.VarChar(64)
  swiftCode     String?  @db.VarChar(32)
  currency      String   @db.VarChar(8)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("partner_bank_accounts")
}

// ─── 9. Fleet: Vehicles & Drivers ──────────────────────────────────────────

model Vehicle {
  id                 String    @id @default(uuid())
  /// e.g. "VEH-001".
  reference          String    @unique @db.VarChar(32)
  partnerId          String
  partner            Partner   @relation(fields: [partnerId], references: [id])
  plateNumber        String    @unique @db.VarChar(32)
  truckType          String    @db.VarChar(32) // Flatbed | 20ft Container | 40ft Container | Refrigerated | Tanker | Tipper | Box Truck | Low Loader | Other
  containerCapacity  String?   @db.VarChar(32)
  trailerInfo        String?   @db.VarChar(120)
  ownershipType      String    @db.VarChar(16) // Owned | Leased | Rented
  /// The three insurance columns are written FROM the vehicle's Insurance
  /// document — see `DocumentsService.syncVehicleComplianceDates`. The policy
  /// is the paper; these are the paper's facts, kept on the vehicle so a fleet
  /// list can say when a truck falls out of cover without joining documents.
  insuranceProvider  String?   @db.VarChar(160)
  insuranceStartDate DateTime?
  insuranceExpiry    DateTime
  registrationExpiry DateTime
  hasGPS             Boolean   @default(false)
  gpsDeviceId        String?   @db.VarChar(64)
  operationalStatus  String    @default("Available") @db.VarChar(24) // Available | In Transit | Under Maintenance | Out of Service
  /// No standing driver.
  ///
  /// A vehicle used to carry `assignedDriverId` — one driver, `@unique`, set
  /// from the Vehicles page. It was a second, competing answer to a question
  /// `Booking` already answers properly: a booking names the driver *and* the
  /// vehicle that ran it, per trip, which is how the work is actually
  /// dispatched. The standing pair could disagree with every booking on the
  /// road and nothing reconciled them.
  ///
  /// Who drove what is therefore read from `bookings` — see the trip counts
  /// the fleet directories render. Dropped 2026-08-30.
  year               Int?
  make               String?   @db.VarChar(64)
  model              String?   @db.VarChar(64)

  /// The truck's own photograph. A storage key, never a URL — see
  /// `Partner.logoKey`; the presigned link is derived at read time and would
  /// be a dead string by tomorrow if it were stored.
  photoKey String? @db.VarChar(255)

  /// What it burns. Diesel|Petrol|CNG|LNG|Hybrid|Electric — `FUEL_TYPES` in
  /// `co2.util.ts`. One of the three answers the carbon factor is derived
  /// from, which is why it is asked for at registration rather than left to a
  /// spec sheet nobody opens.
  fuelType String @default("Diesel") @db.VarChar(24)

  /// kg CO₂ per kilometre for this truck. **Never typed in.** Computed from
  /// `truckType` + `fuelType` + `year` by `computeVehicleCo2Factor` on every
  /// write that touches one of those three, so a fleet's factors are all
  /// arrived at the same way and can be compared.
  ///
  /// Nullable only for the moment between a row existing and the backfill
  /// reaching it; every live write sets it.
  co2PerKm        Decimal?  @db.Decimal(6, 3)
  /// One line saying how the number above was reached ("40ft Container ·
  /// Diesel · 2022 (Euro VI-E)"), stored so a reader never has to run the
  /// model in their head, and `CO2_MODEL_VERSION` so a factor computed under
  /// an older table stays identifiable after the table moves.
  co2FactorBasis  String?   @db.VarChar(255)
  co2ModelVersion String?   @db.VarChar(32)
  co2FactorAt     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  shipments      Shipment[]
  bookings       Booking[]
  /// The bookings whose empty return leg this truck ran — see
  /// `Booking.returnVehicleId`.
  returnBookings Booking[]  @relation("BookingReturnVehicle")

  @@index([partnerId])
  @@index([operationalStatus])
  @@map("vehicles")
}

model Driver {
  id                   String    @id @default(uuid())
  /// e.g. "DRV-001".
  reference            String    @unique @db.VarChar(32)
  partnerId            String
  partner              Partner   @relation(fields: [partnerId], references: [id])
  fullName             String    @db.VarChar(255)
  phone                String    @db.VarChar(32)
  nationalId           String    @db.VarChar(64)
  drivingLicenseNumber String    @db.VarChar(64)
  /// No `licenseExpiry`. A Djibouti driving licence does not expire, so the
  /// column was a date the system invented and then policed — it drove a
  /// "License Alerts" tile, a verification tick and a nightly expiring query,
  /// all of them reporting on a deadline that does not exist. Dropped
  /// 2026-09-02 at the user's direction. What the licence does have is an
  /// issue date, and that lives on the uploaded document (`documents.issueDate`)
  /// beside the file itself, where every other paper's dates already live.
  nationalIdExpiry     DateTime?
  profilePictureKey    String?   @db.VarChar(512)
  accessCards          Json? // string[]
  /// Reuses the same OperationalStatus vocabulary Vehicle.operationalStatus
  /// already types — not inventing a driver-specific vocabulary.
  status               String    @default("Available") @db.VarChar(24)
  joinDate             DateTime
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  /// No standing vehicle — the pairing lives on each `Booking`. See the note
  /// on `Vehicle.year` for why.
  shipments      Shipment[]
  bookings       Booking[]
  /// The bookings whose EMPTY RETURN leg this driver took. A container's round
  /// trip is two jobs and often two people, so a driver can appear on a booking
  /// through either relation — see `Booking.returnDriverId`.
  returnBookings Booking[]  @relation("BookingReturnDriver")

  @@index([partnerId])
  @@index([status])
  @@map("drivers")
}

// ─── 10. Documents (shared, polymorphic) ───────────────────────────────────

model DocumentType {
  id        String   @id @default(uuid())
  ownerType String   @db.VarChar(16) // SHIPPER | PARTNER | VEHICLE | DRIVER | BOOKING
  label     String   @db.VarChar(120)
  required  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([ownerType, label])
  @@map("document_types")
}

model Document {
  id              String    @id @default(uuid())
  /// SHIPPER | PARTNER | VEHICLE | DRIVER | BOOKING — or FOLDER, for a file
  /// somebody put in a drive folder of their own (see `DriveFolder`).
  ownerType       String    @db.VarChar(16)
  ownerId         String
  /// Free string, validated against the live DocumentType catalog for the
  /// same ownerType at the service layer — not a DB-level FK (matches the
  /// frontend's category: string convention).
  category        String    @db.VarChar(120)
  name            String    @db.VarChar(255)
  storageKey      String    @db.VarChar(512)
  mimeType        String    @db.VarChar(120)
  fileSizeBytes   Int
  status          String    @default("Pending Review") @db.VarChar(20) // Verified | Pending Review | Rejected | Expired
  uploadedAt      DateTime  @default(now())
  uploadedById    String
  /// When the authority actually issued the paper — NOT when it was uploaded.
  /// A grey card filed three years late still dates from the day it was
  /// registered, and `uploadedAt` says nothing about that.
  issueDate       DateTime?
  expiryDate      DateTime?
  /// Who issued it. Asked for on a vehicle's insurance, where it is the
  /// insurer — the one paper whose value depends on whose name is on it, since
  /// a claim is made against the company, not against the certificate.
  issuer          String?   @db.VarChar(160)
  verifiedById    String?
  verifiedAt      DateTime?
  rejectionReason String?   @db.Text
  version         Int       @default(1)
  downloadCount   Int       @default(0)

  @@index([ownerType, ownerId])
  @@map("documents")
}

/// Who opened a document, and when.
///
/// `Document.downloadCount` has always been an integer that went up, which
/// answers "how popular is this file" — a question nobody has ever asked about
/// an insurance certificate. The question people do ask is *who pulled a copy
/// of this*, and for a compliance document that is an audit question: these
/// files are a haulier's licence, a driver's ID and a policy naming a company,
/// and the record of who took one is part of holding them responsibly.
///
/// No relation to Document or User, deliberately, and no cascade: the log
/// outlives both. A document deleted after the fact does not get to erase the
/// record of who read it, and a departed employee's downloads stay attributed.
model DocumentDownload {
  id         String   @id @default(uuid())
  documentId String
  userId     String
  at         DateTime @default(now())

  @@index([documentId, at])
  @@map("document_downloads")
}

/// A folder somebody made in Fleetin Drive, to hold whatever they like.
///
/// Everything else in the drive is derived: a transporter's folder exists
/// because the transporter does, and holds the four papers the catalogue asks
/// for. That tree cannot hold a signed contract, a tender, a photograph of a
/// damaged box — the things people actually wanted to file — so this is the
/// other half of the drive: folders that exist because somebody created them,
/// nested as deep as they like, holding files the catalogue has no opinion on.
///
/// The files themselves are ordinary `Document` rows with `ownerType = FOLDER`
/// and `ownerId` pointing here, so upload, download, preview and the download
/// log are the same code as for a grey card. What they lack is a catalogue:
/// nothing in one of these folders is required, expires, or is reviewed.
///
/// Deleting a folder cascades to its sub-folders at the database; the files
/// inside have no foreign key (documents never do — see `Document`) and are
/// removed by the service, storage and rows both.
model DriveFolder {
  id       String  @id @default(uuid())
  name     String  @db.VarChar(120)
  /// Null at the root of the Files section.
  parentId String?

  /// The record this folder hangs under, when it hangs under one.
  ///
  /// Both null is the Files section — a free tree somebody made. Set, and the
  /// folder lives inside that company's own folder on the compliance drive,
  /// beside the derived Company / Vehicles / Drivers folders. That is where
  /// people actually want to file a contract: they are already looking at the
  /// haulier when they think of it.
  ///
  /// Deliberately NOT a relation, the same rule `Document.ownerId` follows: a
  /// folder can hang off a partner or a shipper, and two nullable foreign keys
  /// to express "one of these" is two indexes and two joins to read a name.
  ownerType String?       @db.VarChar(16)
  ownerId   String?       @db.VarChar(64)
  parent    DriveFolder?  @relation("DriveFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  DriveFolder[] @relation("DriveFolderTree")

  /// Plain column, not a relation — the same rule as `Document.uploadedById`:
  /// a folder outlives the account that made it.
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([parentId])
  /// "What has this company filed?" — the company folder's own listing.
  @@index([ownerType, ownerId])
  @@map("drive_folders")
}

// ─── 11. Shipments ──────────────────────────────────────────────────────

/**
 * A real place on the map — a port, a free zone, a depot, a customer's yard.
 * Until this table existed the corridor's geography lived in three places that
 * did not know about each other: six hardcoded rows in the frontend's Locations
 * page, a list of bare strings in the browser's localStorage that the shipment
 * wizard picked from, and a 25-entry gazetteer in `bi-geo.ts` that mapped a
 * name substring to coordinates so the tracking map had something to draw. A
 * place added in one was invisible to the other two, and none of them held a
 * coordinate anybody had checked.
 * This is the one list. A location is normally created by searching Google
 * Places — `googlePlaceId` is then set and `source` is `google`, so the name,
 * address and coordinates are Google's rather than a typist's. Entering one by
 * hand is still allowed and always will be: a private gate or a yard Google has
 * never heard of is a real place a shipment goes to.
 * Shipments keep their text snapshots (`pickupLocationName` and friends)
 * alongside the new foreign key, the same way they snapshot the shipper and the
 * transporter — a location renamed or removed in 2027 must not rewrite what a
 * 2026 shipment said it was.
 */
model Location {
  id        String @id @default(uuid())
  /// `LOC-00001`, minted by `reference.util.ts` like every other reference.
  reference String @unique @db.VarChar(32)

  name String @db.VarChar(255)
  /// port|free_zone|depot|yard|customer|other — what the place IS, which is
  /// also how the shipment wizard filters it: pickups offer ports, drop-offs
  /// offer free zones, and both can be overridden because a shipment
  /// occasionally runs depot-to-depot.
  kind String @default("other") @db.VarChar(24)

  /// Google's own id for the place. Unique, so the same terminal cannot be
  /// added twice by two people searching for it on two different days. Null
  /// for a place entered by hand.
  googlePlaceId    String? @unique @db.VarChar(255)
  formattedAddress String? @db.Text
  city             String  @default("Djibouti") @db.VarChar(120)
  country          String  @default("Djibouti") @db.VarChar(120)
  countryCode      String? @db.VarChar(2)

  /// Decimal, not Float. Seven decimal places is ~1cm — far more than a truck
  /// gate needs, and it round-trips exactly, which a Float does not.
  latitude  Decimal @db.Decimal(10, 7)
  longitude Decimal @db.Decimal(10, 7)

  /// google|manual — where the coordinates came from. Worth storing: a
  /// hand-dropped pin and a Google-verified terminal are both usable, but only
  /// one of them is worth re-checking when a distance looks wrong.
  source String @default("manual") @db.VarChar(16)

  gateOrTerminal String? @db.VarChar(120)
  contactPerson  String? @db.VarChar(255)
  contactPhone   String? @db.VarChar(32)
  notes          String? @db.Text

  /// Retired rather than deleted: a place that stops being used should stop
  /// being offered, without breaking the shipments that already reference it.
  active Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  distancesFrom     LocationDistance[] @relation("DistanceOrigin")
  distancesTo       LocationDistance[] @relation("DistanceDestination")
  pickupShipments   Shipment[]         @relation("ShipmentPickupLocation")
  deliveryShipments Shipment[]         @relation("ShipmentDeliveryLocation")
  /// The transporters whose trucks are based here — see `Partner.garageLocationId`.
  garageOf          Partner[]          @relation("PartnerGarage")

  @@index([kind])
  @@index([active])
  @@map("locations")
}

/**
 * How far it actually is between two locations, by road, measured once.
 * This is a cache with a very long life, and that is the whole point. Google's
 * Routes API is billed per element, but the road between the Doraleh terminal
 * and the DIFTZ gate is the same road tomorrow as it was today — so a pair is
 * measured on first use and read from here forever after. A corridor of fifteen
 * places is about two hundred pairs; the entire book costs about a dollar to
 * build and nothing to keep.
 * Directional on purpose. `origin -> destination` and the reverse are separate
 * rows because a one-way system, a port gate that only admits inbound traffic,
 * or a bridge under repair makes the return leg a genuinely different length.
 * The Routes API answers them separately, so this stores them separately.
 * `provider` says who measured it. `google` is a real driving route.
 * `haversine` is the straight line between the two coordinates, used when no
 * API key is configured, and it is deliberately marked rather than passed off
 * as a road distance — it is always short, on the corridor by about a third.
 * `manual` is a number an operator stood behind.
 */
model LocationDistance {
  id String @id @default(uuid())

  originId      String
  origin        Location @relation("DistanceOrigin", fields: [originId], references: [id], onDelete: Cascade)
  destinationId String
  destination   Location @relation("DistanceDestination", fields: [destinationId], references: [id], onDelete: Cascade)

  /// Metres and seconds, as Google returns them. Kilometres and drive-time
  /// strings are presentation, and are formatted at the edge.
  distanceMeters  Int
  durationSeconds Int

  /// google|haversine|manual — see the model comment.
  provider   String   @default("google") @db.VarChar(16)
  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([originId, destinationId])
  @@index([destinationId])
  @@map("location_distances")
}

model Shipment {
  id              String @id @default(uuid())
  /// Preserves Mission.id, e.g. "MSN-2026-8801".
  reference       String @unique @db.VarChar(64)
  /// Every booking reference under this shipment, comma-joined — a legacy
  /// single-tier column now derived by `syncShipmentFromBookings`. Widened
  /// from 255 on 2026-08-26: a twenty-container shipment is a real job, and at
  /// 255 the rollup overflowed and took the whole booking write down with it.
  bookingId       String @db.VarChar(1024)
  referenceNumber String @db.VarChar(64)
  dpcsReference   String @db.VarChar(64)
  /// Persists CreateShipmentDto.shipmentSource ('dpcs'|'custom') — previously
  /// only decided how `reference`/`bookingId` were minted at creation time and
  /// was then discarded, so Finance had no way to split its client book by
  /// origination channel. `dpcsReference` can't stand in for this: it's always
  /// populated (a random `DPCS-DJ-####` fallback when none is supplied), so it
  /// doesn't distinguish origin — this column does, going forward.
  source          String @default("custom") @db.VarChar(16)
  status          String @default("Pending") @db.VarChar(24) // Pending|Payment Pending|Assigned|Driver Assigned|En Route|Arrived|Loading|Unloading|POD Submitted|Completed|Cancelled|Failed
  paymentStatus   String @default("Pending") @db.VarChar(24) // Paid|Pending|Overdue|Partially Paid

  shipperId       String
  shipper         Shipper @relation(fields: [shipperId], references: [id])
  /// Denormalized snapshot at creation time — matches Invoice/PaymentOrder's
  /// existing pattern. Some of these fields (rating) have no other home in
  /// the domain model.
  customerName    String  @db.VarChar(255)
  customerCompany String  @db.VarChar(255)
  customerPhone   String  @db.VarChar(32)
  customerEmail   String  @db.VarChar(255)
  customerRating  Float   @default(4.5)

  partnerId            String
  partner              Partner @relation(fields: [partnerId], references: [id])
  transporterName      String  @db.VarChar(255)
  transporterCompany   String  @db.VarChar(255)
  transporterPhone     String  @db.VarChar(32)
  transporterFleetCode String  @db.VarChar(32)
  transporterRating    Float   @default(4.5)

  driverId            String?
  driver              Driver?  @relation(fields: [driverId], references: [id])
  driverName          String?  @db.VarChar(255)
  driverPhone         String?  @db.VarChar(32)
  driverLicenseNumber String?  @db.VarChar(64)
  driverRating        Float?
  driverVerified      Boolean?

  vehicleId                 String?
  vehicle                   Vehicle? @relation(fields: [vehicleId], references: [id])
  vehicleRegistrationNumber String?  @db.VarChar(32)
  vehicleTypeSnapshot       String?  @db.VarChar(64)
  vehicleCapacity           String?  @db.VarChar(64)
  vehicleVerified           Boolean?

  /// The catalogued place this shipment leaves from, when there is one.
  /// Nullable and always will be: every shipment created before the Locations
  /// table existed has only the text below, and a one-off pickup at an address
  /// nobody wants in the picker is a legitimate shipment. The text fields are
  /// the snapshot and stay authoritative for display; this is the link that
  /// lets a distance be measured and a pin be drawn.
  pickupLocationId      String?
  pickupLocation        Location? @relation("ShipmentPickupLocation", fields: [pickupLocationId], references: [id])
  pickupLocationName    String    @db.VarChar(255)
  pickupLocationAddress String    @db.Text
  pickupLocationCity    String    @db.VarChar(120)
  pickupGateOrTerminal  String?   @db.VarChar(120)
  pickupContactPerson   String?   @db.VarChar(255)
  pickupContactPhone    String?   @db.VarChar(32)

  /// The catalogued place this shipment is delivered to. Same contract as
  /// `pickupLocationId` above.
  deliveryLocationId      String?
  deliveryLocation        Location? @relation("ShipmentDeliveryLocation", fields: [deliveryLocationId], references: [id])
  deliveryLocationName    String    @db.VarChar(255)
  deliveryLocationAddress String    @db.Text
  deliveryLocationCity    String    @db.VarChar(120)
  deliveryGateOrTerminal  String?   @db.VarChar(120)
  deliveryContactPerson   String?   @db.VarChar(255)
  deliveryContactPhone    String?   @db.VarChar(32)

  /// ── Carbon, rolled up from this shipment's bookings ──
  ///
  /// The sum of `Booking.co2EmissionsKg` and `Booking.actualDistanceKm`,
  /// written by `EmissionsService.rollUpShipment` after every booking write
  /// that changes one. Denormalised for one reason: the shipments *list* has
  /// to print a job's carbon without loading the bookings underneath every
  /// row, and a list that fetched them would be a query per card.
  ///
  /// One writer, so the total can never disagree with the cards it totals.
  /// NULL — never 0 — while nothing under it has moved: a shipment that has
  /// not been driven yet has no figure, and zero would read as a measurement.
  ///
  /// `co2DistanceKm` is the sum of the *trucks'* roads, not the length of the
  /// lane: five containers down a 27 km corridor is 135 truck-kilometres, and
  /// that is what produced the carbon. It is deliberately NOT comparable to
  /// `estimatedDistanceKm` below, which is one hop, quoted.
  co2EmissionsKg Decimal? @db.Decimal(12, 2)
  co2DistanceKm  Decimal? @db.Decimal(11, 2)

  estimatedDistanceKm     Float
  /// How `estimatedDistanceKm` was arrived at. Until 2026-09-02 there was only
  /// one answer and it was not recorded: a substring match on the drop-off name
  /// returning 10, 15, 20 or 25 — a guess that Finance and BI then multiplied by
  /// the container count. `google` is a measured road route, `manual` is a
  /// number the operator typed or corrected, `estimate` is that old guess and
  /// what every pre-existing row is backfilled to, honestly.
  estimatedDistanceSource String    @default("estimate") @db.VarChar(16)
  /// Display string, e.g. "18h 30m" — Mission types it as a string, not a number.
  estimatedDurationHours  String    @db.VarChar(32)
  cargoType               String    @db.VarChar(120)
  shipmentCategory        String?   @db.VarChar(24) // container_20|container_40|bulk|machinery|containerized|bulky_goods|special
  /// Every container under this shipment, comma-joined — derived, and what
  /// shipment search matches on. Widened from 64 for the same reason as
  /// `bookingId`: four containers already filled it.
  containerNumber         String?   @db.VarChar(1024)
  shippingLine            String?   @db.VarChar(64)
  containerReturnDepot    String?   @db.VarChar(255)
  containerReturnDeadline DateTime?
  containerReturnFreeDays Int?
  goodsDescription        String    @db.Text
  totalWeightKg           Float
  dimensions              String?   @db.VarChar(120)
  equipmentType           String?   @db.VarChar(120)
  bulkCommodity           String?   @db.VarChar(120)
  bulkHandlingMethod      String?   @db.VarChar(120)
  machineryType           String?   @db.VarChar(120)
  lashingStandard         String?   @db.VarChar(120)
  requiredDocuments       Json? // string[]

  scheduledPickupTime   DateTime
  /// When the shipper expects the goods at the drop-off. Optional, and
  /// deliberately not derived from the pickup: on this corridor a 15km run and
  /// a cross-border one both leave the same morning, and only the shipper
  /// knows which day they have cleared to receive. Null on every shipment
  /// created before 2026-09-01, so every reader must treat it as absent
  /// rather than as "same day".
  scheduledDeliveryTime DateTime?
  completedAt           DateTime?

  /// Money shape per convention. Currency is DJF ("FDJ") in practice — the
  /// fields still carry currency/fxRate/baseAmount so this is the same
  /// shape as every other monetary field in the schema, not a special case.
  rateMinorUnits           BigInt
  rateCurrency             String @default("DJF") @db.VarChar(8)
  rateFxRate               Float  @default(1.0)
  rateBaseAmountMinorUnits BigInt

  /// What the shipper is billed — the revenue side. `rateMinorUnits` above is
  /// the transporter cost side; the two are independent numbers. Resolved at
  /// creation time from the shipper's own `ShipperRate` card, the same way
  /// `rateMinorUnits` is resolved from the transporter's `PricingTier` grid,
  /// so a shipment normally arrives priced. Still nullable, for the one case
  /// that survives: the shipper has no rate covering this lane yet. Left
  /// null then rather than estimated as 0, and never invoiced until set.
  clientRateMinorUnits           BigInt?
  clientRateCurrency             String? @default("DJF") @db.VarChar(8)
  clientRateFxRate               Float?  @default(1.0)
  clientRateBaseAmountMinorUnits BigInt?

  /// Dead since 2026-09-03: the payout-release gate went with the
  /// working-capital module. Columns kept because historical rows carry real
  /// dates; nothing reads or writes them. See `transporterPaidAt` below for
  /// what replaced them.
  payoutReleasedAt     DateTime?
  payoutReleasedById   String?
  payoutReleasedByName String?   @db.VarChar(255)

  /// ── Paying the haulier ──
  ///
  /// The money side of this business runs one way: the shipper pays Fleetin,
  /// Fleetin pays the transporter. `Invoice.paidAt` records the first half;
  /// this records the second.
  ///
  /// One payment per shipment, not per booking — a haulier who carried ten of
  /// a shipment's containers is paid once. The amount is SNAPSHOTTED rather
  /// than derived at read time, because it is what actually left the account:
  /// renegotiating a commission next month must not restate a transfer that
  /// already happened.
  ///
  /// Null is the normal state for work still running, and for delivered work
  /// nobody has paid yet — which is exactly the queue the Billing page shows.
  transporterPaidAt            DateTime?
  transporterPaidMinorUnits    BigInt?
  transporterPaidById          String?
  transporterPaidByName        String?   @db.VarChar(255)

  /// A commercial-agreement grouping over shipments for one shipper — see
  /// `Project`'s own doc comment. Null is a normal, common state.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  timeline  ShipmentTimelineStep[]
  /// The Fleetin staff working this shipment — see `ShipmentAssignee`.
  assignees ShipmentAssignee[]
  /// One row per container the shipper asked for — see `Booking`'s own doc
  /// comment for why this exists alongside the shipment-level fields above
  /// rather than replacing them yet.
  bookings  Booking[]
  holds     PayoutHold[]
  /// Its proforma and its invoice — at most one of each in practice.
  invoices  Invoice[]
  /// The shipment's conversation — including the comments scoped to one of
  /// its bookings, which hang off the shipment too so the whole thread can be
  /// read in one query. See `Comment`.
  comments  Comment[]

  @@index([shipperId])
  @@index([partnerId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([status])
  @@index([scheduledPickupTime])
  @@index([projectId])
  @@index([pickupLocationId])
  @@index([deliveryLocationId])
  @@map("shipments")
}

model ShipmentTimelineStep {
  id          String    @id @default(uuid())
  shipmentId  String
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  key         String    @db.VarChar(32) // creation|booking_confirmation|vehicle_assignment|driver_assignment|gate_in|pickup|departure|arrival|pod_upload|completion
  title       String    @db.VarChar(255)
  description String    @db.Text
  timestamp   DateTime?
  status      String    @db.VarChar(16) // completed|current|pending|failed|skipped
  actor       String?   @db.VarChar(255)
  location    String?   @db.VarChar(255)
  podFileUrl  String?   @db.Text
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())

  @@index([shipmentId])
  @@map("shipment_timeline_steps")
}

/// One Fleetin person on one shipment — the "crew".
///
/// A shipment is worked by staff, not only by carriers: someone chases the
/// documents, someone watches the empties, someone answers when the shipper
/// calls. Until now that fact lived in people's heads, so "who is on
/// MSN-08801?" had no answer the system could give.
///
/// Deliberately a join table rather than an `assigneeId` column on `Shipment`,
/// because a real job has more than one person on it and the single column
/// would force a choice the operation does not actually make.
///
/// `isLead` is the one distinction that survives: whoever is on point, i.e.
/// who you call. Exactly one row per shipment carries it — enforced in
/// `setAssignees`, not by the database, since MySQL has no partial unique
/// index. A crew with no lead is legal and means nobody has claimed point yet.
model ShipmentAssignee {
  id           String   @id @default(uuid())
  shipmentId   String
  shipment     Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  /// The staff account. `onDelete: Cascade` — an account that no longer exists
  /// is not "assigned"; the shipment goes back to unassigned rather than
  /// pointing at a ghost.
  userId       String
  user         User     @relation("ShipmentCrew", fields: [userId], references: [id], onDelete: Cascade)
  /// On point. At most one per shipment.
  isLead       Boolean  @default(false)
  assignedAt   DateTime @default(now())
  /// Who put them on it. Nullable for rows created by a seed or a migration.
  assignedById String?
  assignedBy   User?    @relation("ShipmentCrewAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  /// One row per person per shipment — assigning twice is a no-op, not a
  /// duplicate avatar in the stack.
  @@unique([shipmentId, userId])
  @@index([userId])
  @@index([shipmentId])
  @@map("shipment_assignees")
}

/// One thing somebody said on a shipment.
///
/// ## One thread, not two
///
/// A comment always names a shipment, and *optionally* one of its bookings.
/// That is deliberate: a shipment's conversation is one thread, and
/// `bookingId` is a scope inside it — "this is about container MSKU4567890"
/// — not a second, separate thread hidden behind a container. The Shipment
/// Overview page reads the whole thread and labels the scoped ones; the
/// booking sheet reads the same rows filtered to that booking. This is the
/// same "the container picker is half a scope switch" shape the shipment
/// report block already uses.
///
/// Keeping `shipmentId` populated even on a booking comment is what makes
/// that one query possible — walking `booking.shipmentId` would mean either
/// a join per row or two round trips, on the page that shows the thread.
///
/// ## Attribution is a relation, not a snapshot
///
/// Unlike `PayoutHold`, which snapshots `raisedByName`, the author here is a
/// live FK. A thread is read as a conversation between people who are still
/// in the building: their current name and avatar is what a reader needs, and
/// a renamed colleague should not appear under two identities halfway down.
/// `onDelete: Restrict` — a deleted account must not silently take its half
/// of a conversation with it.
///
/// ## Editing and deleting
///
/// Both are soft and author-only. `editedAt` is what the UI marks as
/// "edited"; a deleted comment keeps its row and its place in the thread so
/// the replies around it still make sense, and the service never returns its
/// body.
model Comment {
  id String @id @default(uuid())

  /// The thread this belongs to. Always set — see the doc comment above.
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  /// The container this comment is *about*, when it is about one. Null means
  /// it speaks to the whole shipment.
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  body String @db.Text

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Set on the first edit — absent means "as written".
  editedAt  DateTime?
  /// Soft delete: the row stays, the body is never served again.
  deletedAt DateTime?

  /// The thread read, oldest first — one shipment, in order.
  @@index([shipmentId, createdAt])
  /// The booking sheet's filtered read.
  @@index([bookingId, createdAt])
  @@index([authorId])
  @@map("comments")
}

// ─── 12. Bookings & Empty Returns ──────────────────────────────────────────
//
// A `Shipment` is the shipper's request ("20 containers to this freezone");
// a `Booking` is one container in it, tracked individually for delivery and
// — containers only — its own empty return. Bulk/machinery shipments get
// bookings the same way, just without the empty-return leg. This is
// additive to `Shipment`, not a replacement: the shipment-level fields this
// migration duplicates onto `Booking` (`containerNumber`,
// `containerReturn*`) stay on `Shipment` too, because the existing create/
// update flow still writes them and nothing yet reads bookings instead —
// that rewire is separate, scoped work. `Booking.status` reuses the exact
// same vocabulary and transition ladder as `Shipment.status`
// (`shipment-status.util.ts`) rather than inventing a second one.

model Booking {
  id        String @id @default(uuid())
  /// e.g. "BKG-1178".
  reference String @unique @db.VarChar(32)

  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  status String @default("Pending") @db.VarChar(24) // same ladder as Shipment.status

  cargoType        String  @db.VarChar(120)
  shipmentCategory String? @db.VarChar(24) // container_20|container_40|bulk|machinery|containerized|bulky_goods|special
  /// Empty-return eligibility gate: only a containerized booking has one.
  containerNumber  String? @db.VarChar(64)
  shippingLine     String? @db.VarChar(64)

  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  driverId  String?
  driver    Driver?  @relation(fields: [driverId], references: [id])

  /// Who takes the empty box back, when that is not who delivered it.
  ///
  /// A container's round trip is two jobs. The transporter sends a truck and a
  /// driver to deliver the load, and days later — after the consignee has
  /// stripped the box — sends a truck and a driver again to fetch the empty.
  /// It is frequently not the same pair, and until this migration the second
  /// pair was simply not recorded: the empty leg was credited to whoever had
  /// driven the delivery, which is the wrong person's trip count and the wrong
  /// person's stars.
  ///
  /// Null means the empty went back with the delivery crew — the ordinary case,
  /// and the reason this is not required. Recorded on the `Empty Picked Up`
  /// rung, which is the moment somebody actually knows who is fetching it.
  /// Same transporter either way: `partnerId` covers both legs, because a
  /// carrier who delivered a box is the carrier who owes its return.
  returnDriverId  String?
  returnDriver    Driver?  @relation("BookingReturnDriver", fields: [returnDriverId], references: [id])
  returnVehicleId String?
  returnVehicle   Vehicle? @relation("BookingReturnVehicle", fields: [returnVehicleId], references: [id])

  /// The return commitment for this specific container — per-booking, not
  /// per-shipment, because a 20-container shipment can carry 20 different
  /// return deadlines.
  containerReturnDepot    String?   @db.VarChar(255)
  containerReturnDeadline DateTime?
  containerReturnFreeDays Int?

  /// "Standalone empty return required" — the one manual override Operations
  /// keeps: matching has stopped for this container, it goes back on its own.
  /// Lives here, not on `EmptyReturnCycle`, because an unmatched booking has
  /// no cycle row to carry it — a booking can be flagged before it is ever
  /// offered for matching at all.
  emptyReturnException String? @db.VarChar(64)

  /// When Operations planned this container's standalone empty return for.
  /// Set together with `emptyReturnException` on the "Plan Empty Return"
  /// decision: the flag says matching has stopped, this says when the box is
  /// actually going back. Kept on the booking beside the flag it belongs to,
  /// for the same reason — an unmatched box has no cycle row to carry it.
  emptyReturnPlannedAt DateTime?

  /// How many empty containers this booking can take back on its outbound leg
  /// — v19's `qty`. Null means one, which is every ordinary single-container
  /// booking; a value >1 lets one full load absorb several empties, and the
  /// matching service refuses the (n+1)th.
  emptySlots Int?

  /// Road distance between where the empty currently sits and this load's
  /// pickup hub. v19 scores pairings on it (`distKm`), so it has to be a real
  /// stored number rather than something the UI guesses per render.
  emptyReturnDistanceKm Decimal? @db.Decimal(8, 2)

  scheduledPickupTime DateTime?
  completedAt         DateTime?

  /// When this booking's own container was emptied and became available to go
  /// back — recorded by hand on the "Empty Ready" rung, because the box is
  /// emptied at the consignee's yard hours before anybody records it and every
  /// detention day is counted from that moment, not from the click. Lives here
  /// rather than only on `EmptyReturnCycle` because this is what puts the
  /// container into the matching pool in the first place: an unmatched box has
  /// no cycle row to carry it.
  emptyReadyAt DateTime?

  /// How the delivery actually went, recorded by the operator at the moment
  /// they mark the booking Delivered.
  ///
  /// This is the rating. Since 2026-08-30 the frontend's `lib/rating.ts`
  /// computes no star of its own: it still measures the mission window, the
  /// turnaround and whether the box came home on time, and it reports those as
  /// figures, but the stars beside a driver's name are these columns and only
  /// these columns. A carrier's star is the same marks rolled up across its
  /// drivers — there is no separate transporter score, because nobody is ever
  /// asked to give one.
  /// The overall — the mean of whichever axes below were answered. Stored
  /// rather than derived so a reader never has to know the averaging rule.
  driverRating                Int?      @db.TinyInt
  /// The three axes the debrief asks, of the person who just watched the
  /// delivery. What the profile's three bars print back, verbatim.
  driverRatingReliability     Int?      @db.TinyInt
  driverRatingPunctuality     Int?      @db.TinyInt
  driverRatingProfessionalism Int?      @db.TinyInt
  driverNote                  String?   @db.Text
  /// Who wrote the debrief, and when. The name is denormalised on purpose: it
  /// is what the sheet prints, and "recorded by" has to keep naming the person
  /// who actually wrote it even after that account is renamed or deactivated.
  /// Set server-side from the authenticated user — never accepted from the
  /// client, which could otherwise sign somebody else's name to an opinion.
  driverRatedById             String?   @db.VarChar(191)
  driverRatedByName           String?   @db.VarChar(255)
  driverRatedAt               DateTime?

  /// The return driver's debrief, asked when the box is actually home.
  ///
  /// Same three axes, same 1-5, same rule as every other star in this product:
  /// a person's answer or nothing. Kept apart from `driverRating*` because they
  /// are answers about two different people doing two different jobs — averaging
  /// them into one column would credit the delivery driver with the return
  /// driver's punctuality and hide both. Only written when `returnDriverId` is
  /// set; when the same driver did both legs the operator is asked once and the
  /// answer lands on `driverRating*`, where that driver's other trips already
  /// are.
  returnDriverRating                Int?      @db.TinyInt
  returnDriverRatingReliability     Int?      @db.TinyInt
  returnDriverRatingPunctuality     Int?      @db.TinyInt
  returnDriverRatingProfessionalism Int?      @db.TinyInt
  returnDriverNote                  String?   @db.Text
  /// Stamped server-side from the token, like every other debrief signature.
  returnDriverRatedById             String?   @db.VarChar(191)
  returnDriverRatedByName           String?   @db.VarChar(255)
  returnDriverRatedAt               DateTime?

  /// The closing debrief — the shipper's half of the round trip, asked when the
  /// box is actually home. How fast they stripped and released it is what ran
  /// the detention clock, and it is otherwise charged to the carrier who only
  /// fetched it. Same three axes, same 1-5, same rule: a person's answer or
  /// nothing. The frontend has collected these since the debrief shipped; until
  /// this migration there was nowhere to put them and every one was discarded.
  shipperRating                Int?      @db.TinyInt
  shipperRatingReliability     Int?      @db.TinyInt
  shipperRatingPunctuality     Int?      @db.TinyInt
  shipperRatingProfessionalism Int?      @db.TinyInt
  shipperNote                  String?   @db.Text
  /// Who wrote it, stamped server-side from the token — never from the client,
  /// which could otherwise sign somebody else's name to an opinion.
  shipperRatedById             String?   @db.VarChar(191)
  shipperRatedByName           String?   @db.VarChar(255)
  shipperRatedAt               DateTime?

  /// What this specific container's own transporter charges — the piece
  /// `Shipment.rateMinorUnits` collapses away by summing across every
  /// booking. Nullable until `partnerId` is set: an unassigned booking has
  /// no transporter to price against yet, never estimated as 0. This is what
  /// `payment-orders` sums per transporter per shipment — money moves per
  /// shipment, never per booking, but each transporter's own cut is the sum
  /// of their own bookings' cost within it.
  transporterCostMinorUnits           BigInt?
  transporterCostCurrency             String? @default("DJF") @db.VarChar(8)
  transporterCostFxRate               Float?  @default(1.0)
  transporterCostBaseAmountMinorUnits BigInt?

  /// ── Carbon ───────────────────────────────────────────────────────────────
  /// The booking is the unit of record for emissions, and these four columns
  /// are why: they are a *snapshot*, not a view of the vehicle.
  ///
  /// `co2FactorUsed` is `Vehicle.co2PerKm` copied at the moment a truck was
  /// put on this job. It is never refreshed. Re-deriving a finished trip from
  /// the truck's present factor would silently rewrite last quarter's carbon
  /// statement every time somebody corrected a vehicle's model year — a
  /// reported figure has to stay the figure that was reported.
  ///
  /// `actualDistanceKm` is the road the truck actually covered: the sum of
  /// this booking's `BookingRouteLeg` rows, each one measured between two
  /// catalogue locations through the same Google distance cache the shipment
  /// wizard uses. `co2DistanceSource` says where it came from, because a
  /// measured route and a fallback are not the same claim.
  ///
  /// `co2EmissionsKg` = `actualDistanceKm` × `co2FactorUsed`. Stored rather
  /// than multiplied at read time so every screen, export and rollup quotes
  /// one number, and so the arithmetic behind a historical figure survives
  /// any later change to either input.
  actualDistanceKm  Decimal?  @db.Decimal(9, 2)
  co2FactorUsed     Decimal?  @db.Decimal(6, 3)
  co2EmissionsKg    Decimal?  @db.Decimal(10, 2)
  /// legs|shipment_estimate|manual — see `EmissionsService.recompute`.
  co2DistanceSource String?   @db.VarChar(24)
  co2ComputedAt     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  timeline   BookingTimelineStep[]
  /// The movement this booking's emissions are measured over — one row per
  /// leg, in order. See `BookingRouteLeg`.
  routeLegs  BookingRouteLeg[]
  /// This booking as the empty going back — at most one live cycle per
  /// booking (matching consumes it).
  asEmpty    EmptyReturnCycle?     @relation("CycleEmptyBooking")
  /// This booking as the full load a cycle is going out to collect.
  /// The empties riding out under this load. A LIST since 2026-08-29: v19
  /// gives a load `emptySlots` capacity, so one outbound booking can carry
  /// several boxes back. `emptySlots` caps it; the service enforces that.
  asNextFull EmptyReturnCycle[]    @relation("CycleNextFullBooking")
  holds      PayoutHold[]
  /// What people have said about this container specifically — a subset of
  /// the shipment's thread, not a separate one. See `Comment`.
  comments   Comment[]

  @@index([shipmentId])
  @@index([partnerId])
  @@index([vehicleId])
  @@index([driverId])
  /// The return leg is queried the same way the delivery leg is — "what has
  /// this driver done", "what has this truck run" — so it gets the same index.
  @@index([returnVehicleId])
  @@index([returnDriverId])
  @@index([status])
  @@index([containerNumber])
  @@index([co2ComputedAt])
  @@map("bookings")
}

/// One movement of the truck, and how long it was.
///
/// A booking's carbon is its distance times its factor, and the distance has
/// to be the road actually driven — not the straight port-to-zone hop the
/// shipment was quoted on. A container run is normally several legs:
///
///     Garage → Port → Free Zone → Port → Free Zone
///
/// so the route is stored as a list rather than a single number. Each leg is
/// measured between two catalogue `Location` rows through
/// `LocationsService.distance`, which is the same Google Routes call the
/// shipment wizard makes and the same permanently-cached `location_distances`
/// row — a leg down a lane somebody has already driven costs nothing to
/// measure.
///
/// `originLocationId`/`destinationLocationId` are nullable and the names are
/// not, on purpose: a leg to a place that is not in the catalogue (a
/// consignee's own yard) is still a real leg, and it keeps its `manual`
/// distance and its typed name rather than being dropped from the total.
///
/// Legs are rebuilt, never accumulated: `EmissionsService.rebuildRoute`
/// deletes and rewrites the set for one booking, so a route can be corrected
/// without leaving orphan kilometres behind it.
model BookingRouteLeg {
  id String @id @default(uuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// 1-based position in the drive. Unique per booking, so the order is a
  /// fact about the data rather than whatever the query happened to return.
  sequence Int

  originLocationId      String?
  destinationLocationId String?
  /// What the leg is called on screen. Denormalised so a route still reads
  /// after a location is renamed or retired.
  originName            String  @db.VarChar(255)
  destinationName       String  @db.VarChar(255)

  /// Metres and seconds, as the Routes API returns them — kilometres are
  /// presentation, formatted at the edge. Same rule as `LocationDistance`.
  distanceMeters  Int
  durationSeconds Int?

  /// google|haversine|manual — who measured it. A haversine leg is the
  /// straight line and is marked as such rather than passed off as a road.
  provider String @default("google") @db.VarChar(16)

  /// Why this leg is part of the drive: positioning|loaded|empty_return|manual.
  /// Kept so a route can explain itself — an operator looking at 240 km on an
  /// 85 km lane should be able to see which legs made it up.
  purpose String @default("loaded") @db.VarChar(24)

  createdAt DateTime @default(now())

  @@unique([bookingId, sequence])
  @@index([bookingId])
  @@map("booking_route_legs")
}

model BookingTimelineStep {
  id          String    @id @default(uuid())
  bookingId   String
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  key         String    @db.VarChar(32) // creation|booking_confirmation|vehicle_assignment|driver_assignment|gate_in|pickup|departure|arrival|pod_upload|completion
  title       String    @db.VarChar(255)
  description String    @db.Text
  timestamp   DateTime?
  status      String    @db.VarChar(16) // completed|current|pending|failed|skipped
  actor       String?   @db.VarChar(255)
  location    String?   @db.VarChar(255)
  podFileUrl  String?   @db.Text
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())

  @@index([bookingId])
  @@map("booking_timeline_steps")
}

/// One empty↔full match. Deliberately thin: everything about *why* the
/// empty exists and is ready lives on its `Booking` (real status, real
/// timeline) — this row only exists once Operations confirms a match, which
/// is empty-return's one write action. There is no row, and no separate id,
/// for an empty that hasn't been matched yet — "which bookings are empty and
/// ready" is a query over `Booking` (containerized, delivered, no `asEmpty`
/// row yet), not a spawned record.
model EmptyReturnCycle {
  id        String @id @default(uuid())
  /// e.g. "CYC-00005".
  reference String @unique @db.VarChar(32)

  /// The empty going back.
  bookingId String  @unique
  booking   Booking @relation("CycleEmptyBooking", fields: [bookingId], references: [id], onDelete: Cascade)

  /// The full load this cycle picks up on the way back, when it is itself a
  /// tracked booking (it always is — matching only ever offers real open
  /// bookings). Its own `status` is what drives this cycle's `status` below;
  /// nothing here duplicates that ladder.
  /// The full load this empty rides out under.
  ///
  /// Deliberately NOT unique since 2026-08-29: the v19 model gives a full load
  /// `qty` container slots and an `assigned[]` list, so ONE outbound load can
  /// absorb SEVERAL empties (a 2-container booking takes two boxes back). The
  /// old `@unique` encoded a 1:1 assumption the product never actually had —
  /// `Booking.emptySlots` below is what now caps it, checked in the service.
  nextBookingId String?
  nextBooking   Booking? @relation("CycleNextFullBooking", fields: [nextBookingId], references: [id])

  chainId String?
  chain   EmptyReturnChain? @relation(fields: [chainId], references: [id])
  /// 1-based position of this cycle inside its chain.
  seq     Int?

  /// Mirrors `nextBooking.status` through a small mapping (Assigned→preparing,
  /// Driver Assigned→ready, En Route→in_progress, delivered→completed) —
  /// updated by a service-layer hook when the booking's status changes, never
  /// advanced by a click here. See `EmptyReturnsService`.
  status String @default("preparing") @db.VarChar(16) // preparing|ready|in_progress|completed

  /// The decision this cycle is at, stored rather than re-derived.
  ///
  /// v19 keeps `stage` on the record and every screen switches on it; the
  /// frontend used to infer it from (returnedAt, nextFull) instead, which
  /// meant two surfaces could disagree about a container mid-write. One
  /// authoritative word, advanced only by the four service actions.
  stage   String  @default("empty") @db.VarChar(16) // empty|paired|return_planned|closed
  /// How it finished. Null until `stage` is closed.
  outcome String? @db.VarChar(16) // paired|returned|returned_late

  /// Provenance of the pairing — v19's `matchInfo`. Kept because an operator
  /// override and the engine's own pick are different claims, and a board that
  /// shows both without saying which is which is not auditable.
  matchedAt   DateTime?
  matchedBy   String?   @db.VarChar(120)
  /// e.g. "Suggestion — Recommended", "Manual — Matching", "Contextual".
  matchSource String?   @db.VarChar(64)

  /// Stamped when the return leg actually leaves. Distinct from `returnedAt`:
  /// dispatched is "the truck has it", returned is "the depot has it".
  dispatchedAt DateTime?

  emptyReadyAt DateTime?
  /// Stamped once, the first time `nextBooking` reaches a delivered status.
  returnedAt   DateTime?

  /// What the late return actually cost, resolved at close time from the
  /// day-rate in Settings. Stored rather than recomputed so a historic cycle
  /// keeps the price that was in force when it closed.
  detentionFee Decimal? @db.Decimal(12, 2)

  /// ── Fleetin Impact ────────────────────────────────────────────────────
  ///
  /// What this pairing did to the road, once it had actually been driven.
  ///
  /// A cycle is already the link between the operation that ended at the
  /// free zone (`booking`, the empty) and the one that continued from it
  /// (`nextBooking`, the load collected at the port) — which is exactly the
  /// relationship a repositioning saving has to hang on, so the evidence
  /// lives here rather than on a second table that would repeat the link.
  ///
  /// The lifecycle is the match's own:
  ///
  ///     matched → realized → (counted)      the truck really continued
  ///     matched → not_realized              it went back to the garage anyway
  ///
  /// `matched` is a plan. Nothing below is a claim about the world until
  /// `impactStatus` reads `realized`, and nothing reaches a total until
  /// `impactCountedAt` is stamped — one continuation trip is counted exactly
  /// once, however many empties rode out under the load.
  ///
  /// What was avoided is the garage round trip the normal workflow would have
  /// driven between the two jobs — `Free Zone → Garage` plus `Garage → Port`
  /// — never the shipment's own lane, never a percentage. The two halves are
  /// measured through the same road cache the shipment wizard uses and each
  /// is kept, with who measured it, so the figure can be re-derived by hand a
  /// year later. Names are denormalised beside every id for the same reason
  /// `BookingRouteLeg` keeps them: retiring a depot must not erase the record
  /// of a saving. Neither the ids nor the vehicle carry a foreign key, for the
  /// same reason.
  ///
  /// CO₂ avoided is the avoided distance times the factor of the truck that
  /// ran the continuation, and only when that truck is established
  /// (`impactVehicleId`). A transporter-level match with no known truck keeps
  /// its kilometres and leaves the carbon null — a distance is a fact, a
  /// factor without a vehicle is an invention.
  ///
  /// None of this touches `Booking.co2EmissionsKg`. What was driven was
  /// driven; this is the separate account of what was not.
  impactStatus              String?   @db.VarChar(16) // matched|realized|not_realized
  /// Which saving this is, once realized. `continuation`: one carrier's truck
  /// finished at the free zone and went straight to the port for its own next
  /// load — the garage round trip `Free Zone → Garage → Port` was not driven.
  /// `handover`: the empty's carrier (A) and the next load's carrier (B)
  /// differ, so B's truck detoured through the free zone on its way to the
  /// port and A never sent a truck for the box — A's `Garage → Free Zone` and
  /// `Port → Garage` were not driven, less B's detour (`Garage → Free Zone`
  /// minus `Garage → Port`). Both are real road not driven; they are kept
  /// apart because they are two different arguments. The user's ruling of
  /// 2026-09-03: "you have to count them".
  impactModel               String?   @db.VarChar(16) // continuation|handover
  impactEvaluatedAt         DateTime?
  /// automatic — derived from the bookings' own rungs. operator — a person
  /// said what happened, and automatic passes never overrule them.
  impactSource              String?   @db.VarChar(16)
  impactDecidedBy           String?   @db.VarChar(120)
  impactNote                String?   @db.VarChar(255)
  /// When the next load was actually collected at the port — the moment the
  /// continuation became a fact — and how long after the empty left the free
  /// zone that was. The window between them is the evidence.
  impactRealizedAt          DateTime?
  impactContinuationMinutes Int?
  /// The carrier whose driving was saved — the empty's carrier. On a
  /// continuation it is also the next load's carrier; on a handover the next
  /// load's carrier is named separately below.
  impactPartnerId           String?
  impactPartnerName         String?   @db.VarChar(255)
  impactNextPartnerId       String?
  impactNextPartnerName     String?   @db.VarChar(255)
  impactVehicleId           String?
  impactVehiclePlate        String?   @db.VarChar(32)
  impactFromLocationId      String?
  impactFromName            String?   @db.VarChar(255)
  impactGarageLocationId    String?
  impactGarageName          String?   @db.VarChar(255)
  impactToLocationId        String?
  impactToName              String?   @db.VarChar(255)
  /// The two halves of the round trip that was not driven, in metres. On a
  /// continuation: `Free Zone → Garage` and `Garage → Port`. On a handover:
  /// the empty's carrier's `Port → Garage` and `Garage → Free Zone`.
  avoidedToGarageMeters     Int?
  avoidedFromGarageMeters   Int?
  /// Handover only: what the next load's truck drove extra to come through
  /// the free zone — `Garage → Free Zone` less `Garage → Port` — subtracted
  /// from the two halves above. Negative when the free zone is on its way.
  avoidedDetourMeters       Int?
  avoidedDistanceKm         Decimal?  @db.Decimal(9, 2)
  /// google|haversine — a straight line is marked, never passed off as a road.
  avoidedDistanceProvider   String?   @db.VarChar(16)
  avoidedCo2FactorUsed      Decimal?  @db.Decimal(6, 3)
  /// Whose factor priced it: `next_load_truck` (continuation — the truck that
  /// gated in), `delivery_truck` (handover — the empty's own crew, who would
  /// have fetched it), `fleet_average` (that carrier's fleet, when the crew
  /// carries no factor).
  avoidedFactorBasis        String?   @db.VarChar(24)
  avoidedCo2Kg              Decimal?  @db.Decimal(10, 2)
  impactCountedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chainId])
  @@index([status])
  @@index([stage])
  @@index([nextBookingId])
  @@index([impactStatus])
  @@index([impactCountedAt])
  @@index([impactRealizedAt])
  @@index([impactPartnerId])
  @@map("empty_return_cycles")
}

/// The run of consecutive cycles descending from one starting empty — thin
/// on purpose. Its own header figures (completed count, on-time count, max
/// sequence) are computed from `cycles` at read time, the same way the
/// frontend already derives them, rather than stored and risking drift.
model EmptyReturnChain {
  id        String   @id @default(uuid())
  /// e.g. "CHN-00003".
  reference String   @unique @db.VarChar(32)
  createdAt DateTime @default(now())

  cycles EmptyReturnCycle[]

  @@map("empty_return_chains")
}

// ─── 13. Finance Foundation (Phase 4a) ──────────────────────────────────────
//
// The Ledger/Invoice/PaymentOrder/Payment/CreditFacility models above (§1-7)
// already existed in this schema before this section — real, migrated
// tables, but with no NestJS module ever built against them. This section
// adds only what those models don't already cover: a commercial-agreement
// grouping above Shipment, and a payout dispute gate. Everything else Finance
// needs is wired directly onto the existing §1-7 models and onto `Shipment`/
// `Booking` (see their own `clientRate*`/`transporterCost*`/`payoutReleased*`
// fields above) — not duplicated here.

/// A grouping tag over one shipper's shipments — nothing more. Carries only
/// what genuinely can't be derived from the shipments it groups (its own
/// name, its own contract window); it does not fork its own funding-source
/// or channel concept, because those questions are still open at the
/// shipment level and inventing a project-level answer to an undecided
/// question would be worse than not having one.
model Project {
  id            String    @id @default(uuid())
  /// e.g. "PRJ-2026-00003".
  reference     String    @unique @db.VarChar(32)
  name          String    @db.VarChar(255)
  shipperId     String
  shipper       Shipper   @relation(fields: [shipperId], references: [id])
  startedAt     DateTime
  contractEndAt DateTime?
  status        String    @default("active") @db.VarChar(16) // active|completed
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  /// What the shipper expects to run through this project in a month —
  /// an ESTIMATE captured at project-creation time, nothing more. It is
  /// deliberately NOT a budget, a cap, or a credit limit: no code path may
  /// read this to refuse, gate, queue, or warn-and-block a shipment. Real
  /// spend routinely lands far above or below it, and the shipper keeps
  /// working either way. It exists so Finance can see planned-vs-actual on
  /// the project, and for nothing else.
  monthlyEstimateMinorUnits           BigInt?
  monthlyEstimateCurrency             String? @default("DJF") @db.VarChar(8)
  monthlyEstimateFxRate               Float?  @default(1.0)
  monthlyEstimateBaseAmountMinorUnits BigInt?

  shipments Shipment[]
  invoices  Invoice[]

  @@index([shipperId])
  @@index([status])
  @@map("projects")
}

/// Pauses one shipment's (or one booking's) payout — the one manual dispute
/// override the payout workflow keeps. A hold blocks `payment-orders` from
/// paying a transporter on the held shipment; it does not touch `Shipment`/
/// `Booking.status` at all, which keep tracking physical delivery
/// independently of whether the money side is disputed.
model PayoutHold {
  id            String    @id @default(uuid())
  shipmentId    String
  shipment      Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  bookingId     String?
  booking       Booking?  @relation(fields: [bookingId], references: [id])
  category      String    @db.VarChar(32) // weight_mismatch|damage|documentation|other
  reason        String    @db.Text
  raisedById    String
  raisedByName  String    @db.VarChar(255)
  raisedAt      DateTime  @default(now())
  clearedAt     DateTime?
  clearedById   String?
  clearedByName String?   @db.VarChar(255)
  note          String?   @db.Text

  @@index([shipmentId])
  @@index([bookingId])
  @@map("payout_holds")
}

// ═══════════════════════════════════════════════════════════════════════════
// 20. HR & Payroll
//
// Replaces the Excel workbook that ran payroll for the Djibouti entity. Two
// rules govern everything below and are worth stating once:
//
//   1. No rate is hard-coded in TypeScript. Every constant lives in
//      `PayrollConfig` and is resolved by date. A period stores the
//      `configId` it was calculated with, so reopening a 2025 payslip in 2027
//      shows 2025 numbers.
//
//   2. Money is `Decimal(14,4)`, not BigInt minor units like the freight side.
//      DJF has no subunit in practice, but the workbook's own arithmetic
//      produces fractional francs (15.7% of 57,074 is 8,960.618) and those
//      fractions are what CNSS was filed with. Rounding them away at storage
//      would make the filed totals unreproducible.
// ═══════════════════════════════════════════════════════════════════════════

enum ContractType {
  CDI
  CDD
  APPRENTISSAGE
  STAGE
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

/// Drives French grammatical agreement on every generated document
/// (M./Mme, employé/employée, l'intéressé/l'intéressée). It is document
/// data, not a demographic field, and is used for nothing else.
enum Gender {
  M
  F
}

enum PeriodStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID
}

enum EmployeeDocumentCategory {
  CV
  ID_CARD
  PASSPORT
  CONTRACT
  DIPLOMA
  MEDICAL_CERT
  DRIVING_LICENCE
  CNSS_CARD
  WARNING_LETTER
  GENERATED_DOCUMENT
  OTHER
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  MATERNITY
  OTHER
}

enum LeaveStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum DocumentScope {
  EMPLOYEE
  PERIOD
}

model Employee {
  id              String         @id @default(uuid())
  /// Internal staff number, e.g. "EMP-00007".
  matricule       String         @unique @db.VarChar(32)
  fullName        String         @db.VarChar(255)
  gender          Gender
  nationality     String         @db.VarChar(120)
  /// Nullable: not every member of staff is registered with CNSS.
  cnssNumber      String?        @db.VarChar(64)
  nifNumber       String?        @db.VarChar(64)
  /// Job title. Appears on every generated document, so it is required.
  profession      String         @db.VarChar(160)
  department      String?        @db.VarChar(120)
  contractType    ContractType
  /// Drives seniority rate, leave accrual and severance. Never derived.
  joiningDate     DateTime
  /// CDD only.
  contractEndDate DateTime?
  trialPeriodEnd  DateTime?
  /// Monthly gross before overtime and absence.
  baseSalary      Decimal        @db.Decimal(14, 4)
  /// Encrypted at rest (see common/security/field-crypto.util.ts).
  bankAccount     String?        @db.VarChar(512)
  email           String?        @db.VarChar(255)
  phone           String?        @db.VarChar(64)
  status          EmployeeStatus @default(ACTIVE)
  terminationDate DateTime?
  /// Scopes the EMPLOYEE role to its own record, and MANAGER to its own team.
  userId          String?        @unique
  managerId       String?
  manager         Employee?      @relation("EmployeeReportsTo", fields: [managerId], references: [id])
  reports         Employee[]     @relation("EmployeeReportsTo")

  documents    EmployeeDocument[]
  payrollLines PayrollLine[]
  leaveRecords LeaveRecord[]
  overtime     OvertimeEntry[]
  issued       IssuedDocument[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete only. A terminated employee is archived, never removed —
  /// payroll and contract records must survive a labour inspection.
  deletedAt DateTime?

  @@index([status])
  @@index([managerId])
  @@map("hr_employees")
}

model EmployeeDocument {
  id           String                   @id @default(uuid())
  employeeId   String
  employee     Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category     EmployeeDocumentCategory
  /// Object key in the private bucket. NEVER a public URL — reads go through
  /// a 10-minute signed URL issued after a permission check.
  fileKey      String                   @db.VarChar(512)
  /// Kept apart from `fileKey` so a hostile filename can never become a path.
  originalName String                   @db.VarChar(255)
  mimeType     String                   @db.VarChar(120)
  sizeBytes    Int
  issueDate    DateTime?
  /// Powers the expiry dashboard.
  expiryDate   DateTime?
  notes        String?                  @db.Text
  uploadedById String
  uploadedAt   DateTime                 @default(now())
  deletedAt    DateTime?

  @@index([employeeId])
  @@index([expiryDate])
  @@map("hr_employee_documents")
}

/// One rate set, valid over a date range. Every figure the engine needs is
/// here; `PayrollLine` records which set produced it.
model PayrollConfig {
  id            String    @id @default(uuid())
  effectiveFrom DateTime
  effectiveTo   DateTime?
  label         String    @db.VarChar(160)

  contributionCeiling    Decimal @db.Decimal(14, 4) // 400000
  retirementEmployeeRate Decimal @db.Decimal(9, 6) // 0.04
  amuEmployeeRate        Decimal @db.Decimal(9, 6) // 0.02
  amuCeilingAmount       Decimal @db.Decimal(14, 4) // 8000
  employerRate           Decimal @db.Decimal(9, 6) // 0.157
  employerCappedPortion  Decimal @db.Decimal(9, 6) // 0.117
  monthlyHours           Decimal @db.Decimal(9, 4) // 208
  overtimeTier1Rate      Decimal @db.Decimal(9, 4) // 1.25
  overtimeTier1MaxHours  Decimal @db.Decimal(9, 4) // 6
  overtimeTier2Rate      Decimal @db.Decimal(9, 4) // 1.50
  severanceRatePerYear   Decimal @db.Decimal(9, 6) // 0.20
  severanceCnssRate      Decimal @db.Decimal(9, 6) // 0.06
  annualLeaveDays        Decimal @db.Decimal(9, 4) // 30

  /// FALSE reproduces the workbook: the seniority column is computed and
  /// displayed but never added to the gross. Flipping it to TRUE changes what
  /// people are paid, so it is a deliberate, audited setting — never a default.
  seniorityIncludedInGross Boolean  @default(false)
  /// FALSE reproduces the workbook: the employee's 4% retirement contribution
  /// is applied to the UNCAPPED gross even though `cappedSalary` is computed
  /// beside it and the employer's 11.7% portion does respect the ceiling.
  capRetirementEmployee    Boolean  @default(false)
  /// NULL reproduces the workbook: leave accrues continuously from the joining
  /// date with no annual reset and no cap, so balances grow indefinitely.
  leaveCarryOverCapDays    Decimal? @db.Decimal(9, 4)

  itsBrackets    ItsBracket[]
  seniorityBands SeniorityBand[]
  periods        PayrollPeriod[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([effectiveFrom])
  @@map("hr_payroll_configs")
}

/// One 5,000-DJF step of the ITS table. Not a percentage: each band maps to a
/// fixed franc amount. Looked up by indexed range query, never scanned.
model ItsBracket {
  id         String        @id @default(uuid())
  configId   String
  config     PayrollConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  lowerBound Decimal       @db.Decimal(14, 4)
  upperBound Decimal       @db.Decimal(14, 4)
  taxAmount  Decimal       @db.Decimal(14, 4)

  @@unique([configId, lowerBound])
  @@index([configId, lowerBound, upperBound])
  @@map("hr_its_brackets")
}

model SeniorityBand {
  id       String        @id @default(uuid())
  configId String
  config   PayrollConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  minDays  Int
  rate     Decimal       @db.Decimal(9, 6)

  @@unique([configId, minDays])
  @@map("hr_seniority_bands")
}

model PayrollPeriod {
  id       String        @id @default(uuid())
  month    Int
  year     Int
  status   PeriodStatus  @default(DRAFT)
  /// The rate set this period was calculated with. Frozen on calculation so a
  /// historical period never re-reads today's rates.
  configId String
  config   PayrollConfig @relation(fields: [configId], references: [id])

  calculatedAt DateTime?
  approvedById String?
  approvedAt   DateTime?
  paidAt       DateTime?
  note         String?   @db.Text

  lines    PayrollLine[]
  overtime OvertimeEntry[]
  issued   IssuedDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, year])
  @@index([status])
  @@map("hr_payroll_periods")
}

/// One employee's pay for one period. Every field is a SNAPSHOT written at
/// calculation time and never recomputed — including the employee's own name
/// and profession, so a payslip reprinted years later shows what was filed,
/// not what the employee record says today.
model PayrollLine {
  id         String        @id @default(uuid())
  periodId   String
  period     PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id])

  // ── snapshot of the employee ──
  employeeName String   @db.VarChar(255)
  matricule    String   @db.VarChar(32)
  profession   String   @db.VarChar(160)
  nationality  String   @db.VarChar(120)
  cnssNumber   String?  @db.VarChar(64)
  bankAccount  String?  @db.VarChar(512)
  joiningDate  DateTime

  // ── inputs ──
  baseSalary       Decimal @db.Decimal(14, 4)
  absenceDeduction Decimal @default(0) @db.Decimal(14, 4)
  overtimeHours    Decimal @default(0) @db.Decimal(9, 4)
  overtimeAmount   Decimal @default(0) @db.Decimal(14, 4)

  // ── derived ──
  currentGross         Decimal @db.Decimal(14, 4)
  /// 0 / 0.02 / 0.04 / 0.06 / 0.08 / 0.10
  seniorityRate        Decimal @db.Decimal(9, 6)
  /// Display-only unless `PayrollConfig.seniorityIncludedInGross` is set.
  seniorityAmount      Decimal @db.Decimal(14, 4)
  cappedSalary         Decimal @db.Decimal(14, 4)
  retirementEmployee   Decimal @db.Decimal(14, 4) // 4%
  amuEmployee          Decimal @db.Decimal(14, 4) // 2%
  employerContribution Decimal @db.Decimal(14, 4) // 15.7%
  totalCnss            Decimal @db.Decimal(14, 4) // the "21.7%" line
  taxableWages         Decimal @db.Decimal(14, 4)
  its                  Decimal @db.Decimal(14, 4)
  netSalary            Decimal @db.Decimal(14, 4)

  /// Belt and braces on top of `PayrollPeriod.configId`: a line can be traced
  /// to its rate set even if it is exported away from its period.
  configId  String
  createdAt DateTime @default(now())

  @@unique([periodId, employeeId])
  @@index([employeeId])
  @@map("hr_payroll_lines")
}

/// Overtime is entered per employee per period and joined on `employeeId`.
/// The workbook joined on row position and paid the wrong people; a unique
/// key on (period, employee) makes that class of bug unrepresentable.
model OvertimeEntry {
  id         String        @id @default(uuid())
  periodId   String
  period     PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  hours125         Decimal @default(0) @db.Decimal(9, 4)
  hours150         Decimal @default(0) @db.Decimal(9, 4)
  hourlyRate       Decimal @db.Decimal(14, 4)
  amount125        Decimal @default(0) @db.Decimal(14, 4)
  amount150        Decimal @default(0) @db.Decimal(14, 4)
  totalAmount      Decimal @default(0) @db.Decimal(14, 4)
  /// Manual input; the workbook had no formula for it.
  absenceDeduction Decimal @default(0) @db.Decimal(14, 4)
  note             String? @db.Text

  updatedAt DateTime @updatedAt

  @@unique([periodId, employeeId])
  @@map("hr_overtime_entries")
}

model LeaveRecord {
  id         String      @id @default(uuid())
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       LeaveType   @default(ANNUAL)
  status     LeaveStatus @default(REQUESTED)
  /// Stored as a period, not a day count, so the attestation de congé can be
  /// generated straight from the record.
  startDate  DateTime
  endDate    DateTime
  /// Calendar days inclusive, frozen on approval.
  days       Decimal     @db.Decimal(9, 4)
  reason     String?     @db.Text

  requestedById String?
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, startDate])
  @@index([status])
  @@map("hr_leave_records")
}

/// The French body text of one generated document, versioned. Editing a
/// template bumps `version`; already-issued documents keep their own snapshot
/// in `IssuedDocument.payloadJson` and are unaffected.
model DocumentTemplate {
  id             String        @id @default(uuid())
  key            String        @unique @db.VarChar(64)
  label          String        @db.VarChar(160)
  scope          DocumentScope
  /// "att" | "cng" | "ifs" | "bp" | "cnss" | "vir"
  refPrefix      String        @db.VarChar(16)
  bodyFr         String        @db.Text
  /// Field descriptors driving step 2 of the generator.
  requiresFields Json
  version        Int           @default(1)
  isActive       Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hr_document_templates")
}

/// One reference number allocation counter. Held under `SELECT ... FOR UPDATE`
/// inside the issue transaction so two people issuing at the same instant
/// cannot be handed the same number.
model DocumentSequence {
  templateKey String @db.VarChar(64)
  year        Int
  lastSeq     Int    @default(0)

  @@id([templateKey, year])
  @@map("hr_document_sequences")
}

/// A document that was actually issued. Never overwritten: reissuing produces
/// a new reference number and a new row.
model IssuedDocument {
  id          String         @id @default(uuid())
  templateKey String         @db.VarChar(64)
  /// NULL for period-scope documents (bordereau, ordre de virement).
  employeeId  String?
  employee    Employee?      @relation(fields: [employeeId], references: [id])
  periodId    String?
  period      PayrollPeriod? @relation(fields: [periodId], references: [id])

  /// Consumed on issue, never reused.
  referenceNo        String   @unique @db.VarChar(64)
  /// Frozen at issue. Never TODAY() at render time — that is exactly the
  /// workbook defect this replaces.
  issueDate          DateTime
  /// Full snapshot of every value rendered, so the PDF can be explained (and
  /// re-rendered byte-identically) years later.
  payloadJson        Json
  fileKey            String   @db.VarChar(512)
  /// Set once the linked EmployeeDocument row exists, for employee-scope docs.
  employeeDocumentId String?

  issuedById String
  createdAt  DateTime @default(now())

  @@index([employeeId])
  @@index([periodId])
  @@index([templateKey])
  @@map("hr_issued_documents")
}

/// Single row. Everything a document prints about the company comes from
/// here — the workbook's leave sheet still carried a different company's name.
model CompanySettings {
  id         String @id @default(uuid())
  name       String @db.VarChar(160)
  legalName  String @db.VarChar(200)
  department String @default("Département des Ressources Humaines") @db.VarChar(200)
  address    String @db.VarChar(255)
  phone      String @db.VarChar(64)
  email      String @db.VarChar(160)
  cnssId     String @db.VarChar(64)
  nif        String @db.VarChar(64)

  bankName        String @db.VarChar(160)
  bankAccountName String @db.VarChar(200)
  bankAccountNo   String @db.VarChar(64)

  /// { name, role } each — signatories are settings, never hard-coded.
  signatoryPrepared Json
  signatoryChecked  Json
  signatoryApproved Json

  /// Reference-number pattern. Tokens: {prefix} {seq} {yy} {yyyy}.
  referencePattern String @default("Fl/{prefix}-{seq}/{yy}") @db.VarChar(64)

  updatedAt DateTime @updatedAt

  @@map("hr_company_settings")
}

/// Every view, upload, download, edit and delete of an employee record,
/// document or payroll line. Append-only.
model HrAuditLog {
  id        String   @id @default(uuid())
  actorId   String   @db.VarChar(64)
  actorName String?  @db.VarChar(255)
  entity    String   @db.VarChar(64)
  entityId  String   @db.VarChar(64)
  action    String   @db.VarChar(32) // view|list|create|update|delete|download|upload|calculate|approve|issue
  detail    Json?
  ipAddress String?  @db.VarChar(64)
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("hr_audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// WORKSPACE
//
// The domain modules above answer "what happened?". Workspace answers "what
// does someone need to do about it?" — and those are deliberately different
// systems. `BKG-01178 -> Driver Assigned` is a domain fact; "Investigate
// delayed pickup, assigned to Ahmed, about BKG-01178" is Workspace.
//
// Nothing here owns or recomputes a domain value. A Workspace row never holds
// a shipment status, a rate, a detention day or a settlement figure; it holds
// a POINTER to the row that does, and the domain module stays authoritative.
//
// Everything is prefixed `workspace_` so it never collides with `comments`,
// which predates this module and is retired by the same migration.
// ─────────────────────────────────────────────────────────────────────────────

enum WorkspaceTaskStatus {
  OPEN
  IN_PROGRESS
  /// Blocked on somebody else. "Waiting" rather than "Blocked" because that is
  /// the word the desk already uses for a container sitting on a third party.
  WAITING
  COMPLETED
  CANCELLED
}

enum WorkspaceTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// What a task or a message can point at.
///
/// There is deliberately no `CONTAINER`: a container is not a row. It is
/// `Booking.containerNumber`, a nullable string on the booking that carries
/// it, so a container reference IS a `BOOKING` reference and the container
/// number is what the chip displays.
enum WorkspaceRecordType {
  SHIPMENT
  BOOKING
  VEHICLE
  DRIVER
  PARTNER
  SHIPPER
  INVOICE
  PAYOUT_HOLD
  EMPTY_RETURN_CYCLE
  EMPTY_RETURN_CHAIN
}

enum WorkspaceTaskEventKind {
  CREATED
  TITLE_CHANGED
  DESCRIPTION_CHANGED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNED
  UNASSIGNED
  DUE_CHANGED
  LINKED
  UNLINKED
  // ── Phase 3 ──
  CHECKLIST_ADDED
  CHECKLIST_DONE
  CHECKLIST_REOPENED
  FOLLOWER_ADDED
  FOLLOWER_REMOVED
  TEMPLATE_USED
  /// Written by the recurrence processor, with no actor — nobody did it.
  RECURRENCE_GENERATED
}

enum WorkspaceNotificationKind {
  MENTIONED
  /// A task was handed to you.
  ASSIGNED
  UNASSIGNED
  TASK_UPDATED
  COMMENT_ADDED
  REPLY_ADDED
  /// A comment was handed to you — lighter than ASSIGNED, same Inbox.
  COMMENT_ASSIGNED
  /// Something you assigned to somebody else came back resolved.
  COMMENT_RESOLVED
}

/// One piece of human work.
///
/// A task needs neither a record nor an assignee. "Renew the office insurance"
/// is real work with no shipment behind it, and a task raised at 2am with
/// nobody to give it to yet is still worth writing down — which is why
/// `assigneeId` is nullable and `WorkspaceTaskLink` is a separate table rather
/// than a `relatedRecordId` column.
///
/// A join table rather than one column because a task about a late container
/// legitimately names both the booking and its shipment, and discovering that
/// after the fact would be a migration on a table with rows.
model WorkspaceTask {
  id        String @id @default(uuid())
  /// `TSK-00184`. Minted by `nextReference()`, the same scheme as every other
  /// Fleetin reference — three letters, a hyphen, five digits.
  reference String @unique @db.VarChar(32)

  title       String  @db.VarChar(255)
  description String? @db.Text

  status   WorkspaceTaskStatus   @default(OPEN)
  priority WorkspaceTaskPriority @default(NORMAL)

  /// Exactly one person is accountable. Followers arrive in Phase 3; until
  /// then, null means nobody has picked it up, which is a state worth seeing.
  assigneeId String?
  assignee   User?   @relation("WorkspaceTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  /// Who raised it. `Restrict`, like `Comment.authorId`: a deleted account must
  /// not silently take the provenance of open work with it.
  createdById String
  createdBy   User   @relation("WorkspaceTaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  dueAt       DateTime?
  /// Stamped when status first reaches COMPLETED. Kept as its own column so
  /// "closed this week" is a query, not a scan of the event rail.
  completedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  links         WorkspaceTaskLink[]
  messages      WorkspaceMessage[]
  events        WorkspaceTaskEvent[]
  notifications WorkspaceNotification[]
  checklist     WorkspaceTaskChecklistItem[]
  followers     WorkspaceTaskFollower[]
  occurrence    WorkspaceTaskOccurrence?
  /// The customer complaint this task answers, when there is one. Most tasks
  /// have none — internal work is the majority of the board.
  ticket        WorkspaceTicket?

  /// "My Tasks", the default landing query.
  @@index([assigneeId, status])
  /// "Assigned by Me".
  @@index([createdById, status])
  /// Overdue and due-today sweeps.
  @@index([status, dueAt])
  @@map("workspace_tasks")
}

/// A task's pointer at a real Fleetin row.
///
/// Deliberately NOT a Prisma relation. Ten nullable foreign keys on one table
/// to express "points at exactly one of these" would be ten indexes and ten
/// joins to read one chip. Existence and read-permission are checked in the
/// service instead, batched per record type — see `record-access.service.ts`.
///
/// `recordRef` is denormalised on purpose: a task list renders `SHI-00412`
/// beside every row, and resolving that from the id would be a second query
/// per row on the app's busiest list.
model WorkspaceTaskLink {
  id     String        @id @default(uuid())
  taskId String
  task   WorkspaceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  recordType WorkspaceRecordType
  recordId   String              @db.VarChar(64)
  /// The human reference — `SHI-00412`, `DJ-4471-AB`, `MSCU-889-2314`.
  recordRef  String              @db.VarChar(64)
  /// A short human hint beside the reference: a shipper's name, a route.
  label      String?             @db.VarChar(160)

  createdAt DateTime @default(now())

  @@unique([taskId, recordType, recordId])
  /// "What is open on this shipment?" — the count beside every Raise button.
  @@index([recordType, recordId])
  @@map("workspace_task_links")
}

/// How the problem reached us.
///
/// Worth a column because it is the first thing asked when a ticket is
/// disputed later — "they said they never told us" is settled by a channel and
/// a timestamp, and on this corridor most of it arrives by phone.
enum WorkspaceTicketChannel {
  PHONE
  EMAIL
  WHATSAPP
  IN_PERSON
  /// Raised by the counterparty themselves, through their own portal.
  PORTAL
}

/// A problem somebody outside Fleetin reported.
///
/// The distinction from `WorkspaceTask` is who it belongs to, not how big it
/// is. A ticket is a **claim made by a counterparty** — a shipper rang about a
/// container, a haulier disputes an invoice — and it exists whether or not
/// anybody has decided what to do about it yet. A task is the work Fleetin
/// does; most of it has no ticket behind it ("renew the office insurance") and
/// always will, which is why this is a separate table rather than a flag on
/// the task.
///
/// The two are joined by ONE task, and the join carries a rule: while a ticket
/// has a task, the ticket's status follows the task's (see
/// `tasks.service.ts`). The alternative — a status on each, maintained by hand
/// — is the double bookkeeping every helpdesk that tries it abandons: the
/// ticket says OPEN for a week after the work was finished, and the customer
/// is chased for an update on something already done.
///
/// `taskId` is nullable and unique. Nullable because a ticket is logged the
/// moment the phone is put down, before anybody has been given the work.
/// Unique because "which task closes this ticket" must have exactly one
/// answer; a problem needing three jobs is three tickets, or one task with a
/// checklist, and both of those already exist.
model WorkspaceTicket {
  id        String @id @default(uuid())
  /// `TKT-00042`. The same three-letters-five-digits scheme as every other
  /// Fleetin reference.
  reference String @unique @db.VarChar(32)

  /// What to call it in a list — the caller's own words, shortened.
  subject     String @db.VarChar(255)
  /// The problem as reported, in full. Not nullable: a ticket with no account
  /// of the problem is a note, and whoever picks it up a week later cannot
  /// ring the caller back to ask what they meant.
  description String @db.Text

  status   WorkspaceTaskStatus    @default(OPEN)
  priority WorkspaceTaskPriority  @default(NORMAL)
  channel  WorkspaceTicketChannel @default(PHONE)

  /// The human who called, and how to reach them again. Free text on purpose:
  /// the caller is frequently somebody at the shipper whose name is on no
  /// record here — a warehouse foreman, a driver's brother — and refusing the
  /// ticket until they exist as a row would lose the report.
  reporterName    String? @db.VarChar(160)
  reporterContact String? @db.VarChar(160)

  /// Which Fleetin record the complaint is about, in the same vocabulary a
  /// task link uses. Denormalised the same way and for the same reason: a
  /// ticket list prints the reference beside every row.
  recordType  WorkspaceRecordType?
  recordId    String?              @db.VarChar(64)
  recordRef   String?              @db.VarChar(64)
  recordLabel String?              @db.VarChar(160)

  /// The work raised to fix it. Null until somebody is given the job.
  taskId String?        @unique
  task   WorkspaceTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  /// Who took the call. `Restrict`, like a task's creator: a deleted account
  /// must not take the provenance of an open complaint with it.
  openedById String
  openedBy   User   @relation("WorkspaceTicketOpener", fields: [openedById], references: [id], onDelete: Restrict)

  /// Stamped when the status first reaches COMPLETED or CANCELLED. A ticket is
  /// closed by being answered OR withdrawn, unlike a task, which is only
  /// finished by being done.
  closedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// The open queue, which is what the page lands on.
  @@index([status, priority])
  /// "What has this shipper reported?" — the count beside a record.
  @@index([recordType, recordId])
  @@map("workspace_tickets")
}

/// One message in a Workspace conversation.
///
/// Anchored to a task, OR to a record directly — never both, enforced by a
/// CHECK constraint in the migration. The record anchor exists because the
/// retired `comments` table's rows migrate into it: those were shipment
/// comments with no task behind them, and the standing rule is not to destroy
/// rows.
///
/// Attribution is a live relation, not a snapshot, for the reason `Comment`
/// gave: a thread is read as a conversation between people still in the
/// building, and a renamed colleague should not appear under two identities
/// halfway down.
model WorkspaceMessage {
  id String @id @default(uuid())

  taskId String?
  task   WorkspaceTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  /// The third anchor, added in Phase 2. A message hangs off a task, a record,
  /// OR a channel — still exactly one, still enforced in `messages.service.ts`
  /// because MySQL will not take a CHECK on a column carrying a cascading FK.
  channelId String?
  channel   WorkspaceChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  recordType WorkspaceRecordType?
  recordId   String?              @db.VarChar(64)
  recordRef  String?              @db.VarChar(64)

  /// Stored with `@[user:<id>|Name]` and `@[shipment:SHI-00412]` tokens intact.
  /// The client renders them; the server parses them once, on write, to raise
  /// the mentions. Storing rendered HTML would make every future change to how
  /// a chip looks a data migration.
  body String @db.Text

  authorId String
  author   User   @relation("WorkspaceMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  /// A reply lives in the same conversation as its parent, one level deep.
  /// Deeper nesting is a thread nobody can read on a phone.
  parentMessageId String?
  parentMessage   WorkspaceMessage?  @relation("WorkspaceMessageReplies", fields: [parentMessageId], references: [id], onDelete: Cascade)
  replies         WorkspaceMessage[] @relation("WorkspaceMessageReplies")

  /// ── The assigned comment ────────────────────────────────────────────────
  ///
  /// A message with an `assigneeId` is an *assigned comment*: the lightest
  /// unit of accountability the system has. "@Ahmed this driver is missing his
  /// licence" needs an owner, but it does not need a title, a due date, a
  /// priority or a type — demanding those is what stops somebody writing it
  /// down at all.
  ///
  /// Three columns rather than a second table, because an assigned comment IS
  /// a comment. A `WorkspaceTask` is for work that outlives a sentence; this
  /// is for work that does not. Both land in the same Inbox.
  ///
  /// Note it does NOT reuse `resolvedAt` as a status ladder. An assigned
  /// comment is open or it is resolved; anything needing more states was
  /// always a task.
  assigneeId String?
  assignee   User?   @relation("WorkspaceMessageAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  /// Who did the assigning — the comment header reads "Assigned to X by Y",
  /// and that second name is the whole point: it says who is waiting.
  assignedById String?
  assignedBy   User?     @relation("WorkspaceMessageAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt   DateTime?

  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("WorkspaceMessageResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime?
  deletedAt DateTime?

  mentions      WorkspaceMention[]
  notifications WorkspaceNotification[]

  @@index([taskId, createdAt])
  /// The channel river, oldest last.
  @@index([channelId, createdAt])
  /// Counting a member's unread without reading the bodies.
  @@index([channelId, parentMessageId, createdAt])
  @@index([recordType, recordId, createdAt])
  @@index([authorId])
  @@index([parentMessageId])
  /// "Assigned to me", the Inbox's second half.
  @@index([assigneeId, resolvedAt])
  @@map("workspace_messages")
}

/// Somebody was named in a message.
///
/// A mention is not an assignment and never becomes one — being asked a
/// question is not the same as being handed the job. It notifies, and that is
/// all it does.
model WorkspaceMention {
  id        String           @id @default(uuid())
  messageId String
  message   WorkspaceMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId, createdAt])
  @@map("workspace_mentions")
}

/// A task's own history. Append-only.
///
/// This is the per-task audit rail — who assigned it, when the status moved,
/// what the due date was before. There is deliberately no global activity feed
/// built on it: a chronological river of everybody's events is a surface
/// nobody opens twice. The value is on the task.
///
/// It never duplicates the shipment operational timeline. That stays in
/// Shipments, where it belongs.
model WorkspaceTaskEvent {
  id     String        @id @default(uuid())
  taskId String
  task   WorkspaceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  /// Null for anything the system did on its own — nothing does yet, but
  /// Phase 4's automations will, and an event rail that cannot say "not a
  /// person" would have to lie.
  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  kind WorkspaceTaskEventKind

  /// Rendered values, not ids: the rail must still read correctly after the
  /// thing it names has been renamed or removed.
  fromValue String? @db.VarChar(255)
  toValue   String? @db.VarChar(255)

  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
  @@map("workspace_task_events")
}

/// One thing waiting for one person's attention.
///
/// Read state lives here, server-side, because the bell must survive a
/// refresh and a second device. The Settings notification matrix that writes
/// to localStorage is not connected to this and does not govern it.
model WorkspaceNotification {
  id     String @id @default(uuid())
  /// Who is being told.
  userId String
  user   User   @relation("WorkspaceNotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  kind WorkspaceNotificationKind

  /// Who caused it. Null for the system.
  actorId String?
  actor   User?   @relation("WorkspaceNotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  taskId String?
  task   WorkspaceTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  messageId String?
  message   WorkspaceMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  /// The bell's only query: my unread, newest first.
  @@index([userId, readAt, createdAt])
  @@map("workspace_notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// WORKSPACE · PHASE 2 — Communication
//
// Channels and direct messages, on the message model Phase 1 already has.
// `WorkspaceMessage` gains a THIRD anchor rather than a second table: a
// message belongs to a task, a record, or a channel, and the three read the
// same, render the same and carry the same record chips.
// ─────────────────────────────────────────────────────────────────────────────

enum WorkspaceChannelKind {
  CHANNEL
  /// Exactly two members and no name — the pair's own faces are the name.
  DIRECT
}

enum WorkspaceChannelRole {
  OWNER
  MEMBER
}

/// A room. A named channel, or a two-person DM.
///
/// One model for both because everything downstream is identical — messages,
/// threads, mentions, unread, membership. Two tables would mean two of every
/// query and two of every component, to express a difference that is really
/// just "does it have a name".
model WorkspaceChannel {
  id String @id @default(uuid())

  /// Stable handle. `operations` for a seeded channel; for a DM, the two user
  /// ids sorted and joined — `dm:<a>:<b>`.
  ///
  /// That is what makes the DM unique: two people clicking each other at the
  /// same moment both compute the same key, and the unique index turns the
  /// race into one row instead of two conversations that each hold half the
  /// history.
  key String @unique @db.VarChar(128)

  /// Null for a DM: it is named by whoever you are talking to.
  name  String? @db.VarChar(120)
  topic String? @db.VarChar(255)

  kind      WorkspaceChannelKind @default(CHANNEL)
  /// A private channel is invisible to non-members — not merely read-refused.
  isPrivate Boolean              @default(false)

  createdById String?
  createdBy   User?   @relation("WorkspaceChannelCreator", fields: [createdById], references: [id], onDelete: SetNull)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  members  WorkspaceChannelMember[]
  messages WorkspaceMessage[]

  @@index([kind, archivedAt])
  @@map("workspace_channels")
}

/// Who is in a room, and how far they have read.
model WorkspaceChannelMember {
  id        String           @id @default(uuid())
  channelId String
  channel   WorkspaceChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role WorkspaceChannelRole @default(MEMBER)

  /// The whole unread mechanism, in one column.
  ///
  /// Server-side on purpose: a count kept in the browser is lost on a refresh
  /// and disagrees with itself across two devices, and §7 of the plan is
  /// explicit that localStorage must not be authoritative. Null means the
  /// member has never opened the room, so everything in it is unread.
  lastReadAt DateTime?
  /// Muted: still a member, still counted, but never notified.
  mutedAt    DateTime?
  joinedAt   DateTime  @default(now())

  @@unique([channelId, userId])
  /// The rail's own query: every room I am in.
  @@index([userId])
  @@map("workspace_channel_members")
}

// ─────────────────────────────────────────────────────────────────────────────
// WORKSPACE · PHASE 3 — Productivity
//
// The work that has STEPS (checklists), the people who want to KNOW about it
// (followers), and the work that COMES BACK (templates and recurrence).
// ─────────────────────────────────────────────────────────────────────────────

/// One tick-box on a task. Flat, never nested.
///
/// The source plan rules out deeply nested subtasks and it is right to: a tree
/// is a different product, and "contact partner → request document → verify →
/// update record" is a list, not a hierarchy.
model WorkspaceTaskChecklistItem {
  id     String        @id @default(uuid())
  taskId String
  task   WorkspaceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  text String  @db.VarChar(255)
  done Boolean @default(false)

  doneAt   DateTime?
  doneById String?
  doneBy   User?     @relation("WorkspaceChecklistCompleter", fields: [doneById], references: [id], onDelete: SetNull)

  /// Manual order. A gap-free integer rewritten on every reorder — the list is
  /// a handful of rows, so fractional ranking would be cleverness with no
  /// payoff.
  position Int

  createdAt DateTime @default(now())

  @@index([taskId, position])
  @@map("workspace_task_checklist_items")
}

/// Somebody who wants to hear about a task without owning it.
///
/// The third of three distinct relationships, and the distinction is the whole
/// point:
///   **assignee** — responsible for finishing it. Exactly one.
///   **mention**  — asked a question in one message. Notified once.
///   **follower** — wants the updates. Notified on changes, owns nothing.
///
/// Without this, a manager who wants to keep sight of a job has to assign it to
/// themselves, and then nobody knows who is actually doing it.
model WorkspaceTaskFollower {
  id     String        @id @default(uuid())
  taskId String
  task   WorkspaceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("WorkspaceTaskFollower", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([taskId, userId])
  @@index([userId])
  @@map("workspace_task_followers")
}

/// A named shape for work that recurs in form rather than on a schedule.
///
/// Deliberately thin: a title, a default priority, a due offset and a
/// checklist. No conditional record behaviour and no assignee strategy — for a
/// desk of eight, a template is a checklist somebody would otherwise retype,
/// and anything more is a builder nobody asked for.
model WorkspaceTaskTemplate {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(120)
  title       String  @db.VarChar(255)
  description String? @db.Text

  priority  WorkspaceTaskPriority @default(NORMAL)
  /// Days from creation to the due date. Null leaves the task with no deadline.
  dueInDays Int?

  createdById String?
  createdBy   User?   @relation("WorkspaceTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  items       WorkspaceTaskTemplateItem[]
  recurrences WorkspaceTaskRecurrence[]

  @@index([archivedAt])
  @@map("workspace_task_templates")
}

model WorkspaceTaskTemplateItem {
  id         String                @id @default(uuid())
  templateId String
  template   WorkspaceTaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  text     String @db.VarChar(255)
  position Int

  @@index([templateId, position])
  @@map("workspace_task_template_items")
}

enum WorkspaceRecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

/// "Every Monday, review outstanding transporter balances."
///
/// The rule is not a task. It mints tasks, and each one it mints is an ordinary
/// `WorkspaceTask` that can be reassigned, commented on and closed without
/// touching the rule.
model WorkspaceTaskRecurrence {
  id String @id @default(uuid())

  /// Optional: a rule can carry its own title, or point at a template so the
  /// generated task arrives with a checklist already on it.
  templateId String?
  template   WorkspaceTaskTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  title       String                @db.VarChar(255)
  description String?               @db.Text
  priority    WorkspaceTaskPriority @default(NORMAL)

  frequency  WorkspaceRecurrenceFrequency
  /// Every N days/weeks/months. 1 unless somebody wants a fortnight.
  interval   Int                          @default(1)
  /// 0–6, Sunday first. Weekly rules only.
  weekday    Int?
  /// 1–31. Monthly rules only; a 31 in a 30-day month clamps to the last day
  /// rather than skipping the month.
  dayOfMonth Int?

  assigneeId String?
  assignee   User?   @relation("WorkspaceRecurrenceAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("WorkspaceRecurrenceCreator", fields: [createdById], references: [id], onDelete: SetNull)

  /// The date the next task is due to be minted. Stored as a date, not an
  /// instant: "every Monday" is a calendar fact, and an instant would drift
  /// with the clock the processor happens to run on.
  nextRunOn DateTime  @db.Date
  lastRunOn DateTime? @db.Date
  enabled   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  occurrences WorkspaceTaskOccurrence[]

  /// The processor's only query: rules that are due.
  @@index([enabled, nextRunOn])
  @@map("workspace_task_recurrences")
}

/// One task a rule actually produced.
///
/// **This table is the duplicate guard**, and the reason it is a table at all.
/// The unique pair means the second attempt at the same occurrence fails on
/// the index rather than on a check the code has to remember to perform — so a
/// processor that runs twice, a retry after a partial failure, and two workers
/// racing all converge on one task instead of three.
///
/// The plan is explicit that title comparison is not good enough for this, and
/// it is right: two people can legitimately raise "Review vehicle documents"
/// on the same morning.
model WorkspaceTaskOccurrence {
  id           String                  @id @default(uuid())
  recurrenceId String
  recurrence   WorkspaceTaskRecurrence @relation(fields: [recurrenceId], references: [id], onDelete: Cascade)

  /// The calendar day this occurrence is *for*, not when it was generated.
  occurrenceOn DateTime @db.Date

  taskId String        @unique
  task   WorkspaceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([recurrenceId, occurrenceOn])
  @@map("workspace_task_occurrences")
}
